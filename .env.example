# Cloudflare R2 configuration
# ---------------------------
# Copy these keys into your local `.env` (which is gitignored) with the real values.
# The migration script and the Netlify upload functions read them from the environment.
#
# - R2_PUBLIC_BASE_URL is NOT secret — also set it in Netlify for "All deploy contexts".
# - The ACCESS_KEY_ID / SECRET_ACCESS_KEY are SECRET — keep them only in .env (local)
#   and in Netlify's encrypted env vars (production). Never commit real values.

R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=lowdo-assets
R2_S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
