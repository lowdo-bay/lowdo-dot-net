---

{# ─────────────────────────────────────────────────────────────────────
   ADU LIBRARY — working page
   Structurally based on Mockup B (Catalog) but reads the live
   `aduLibrary` collection instead of static JS data. Each row is a
   link to the standard /project/{slug}/ page; all downloads happen
   there via the existing email-gated Design Toolkit section.
   ───────────────────────────────────────────────────────────────────── #}

<style>
  /* Sticky filter rail under the header */
  .adu-filters {
    position: sticky;
    top: 121px;
    z-index: 900;
    background: var(--color-background);
    display: grid;
    grid-template-columns: 1fr;
  }
  @media (min-width: 840px) {
    .adu-filters { grid-template-columns: repeat(4, 1fr); }
  }
  .adu-filters::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    border-bottom: var(--grid-line-thickness) var(--grid-line-horizontal-minor-style) var(--grid-line-color);
  }

  .adu-filter-block { padding: var(--space-2); }
  @media (max-width: 839px) {
    .adu-filter-block { border-bottom: var(--grid-line-thickness) var(--grid-line-horizontal-minor-style) var(--grid-line-color); }
  }
  .adu-filter-block__heading {
    font-size: var(--font-size-small);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent-1);
    margin-bottom: var(--space-2);
  }
  .adu-filter-block__list {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--space) * 0.75);
    font-size: var(--font-size-small);
  }

  /* Result count + clear */
  .adu-meta {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    align-items: baseline;
  }
  @media (min-width: 840px) {
    .adu-meta { grid-template-columns: repeat(4, 1fr); }
  }
  .adu-meta::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    border-bottom: var(--grid-line-thickness) var(--grid-line-horizontal-major-style) var(--grid-line-color);
    pointer-events: none;
  }
  .adu-meta__count {
    grid-column: 1 / 4;
    padding: var(--space-2);
    font-size: var(--font-size-small);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .adu-meta__count strong { color: var(--color-accent-1); }
  .adu-meta__clear {
    grid-column: 4;
    padding: var(--space-2);
    cursor: pointer;
    text-decoration: underline;
    color: var(--color-accent-1);
    background: none; border: none;
    font: inherit;
    font-size: var(--font-size-small);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-align: right;
  }
  @media (max-width: 839px) {
    .adu-meta__count { grid-column: 1; }
    .adu-meta__clear { grid-column: 1; text-align: left; }
  }

  /* Anchor wrapper — proven pattern from existing index-row-link.
     The link is the wrapper; the grid is on the inner .adu-row div. */
  .adu-row-link {
    display: block;
    text-decoration: none !important;
    color: var(--color-text) !important;
    position: relative;
  }
  .adu-row-link:hover {
    text-decoration: none !important;
    color: var(--color-text) !important;
  }

  /* Library row — same shape as /all/ index rows but on the standard 4-col grid */
  .adu-row {
    display: grid;
    grid-template-columns: 1fr;
    position: relative;
    align-items: stretch;
    min-height: 6rem;
    padding: 0;
  }
  @media (min-width: 840px) {
    .adu-row { grid-template-columns: repeat(4, 1fr); }
  }

  /* Hover tint full screen width — fires on the link, draws on the row */
  .adu-row::before {
    content: '';
    position: absolute;
    top: 0; bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    background-color: transparent;
    transition: background-color var(--transition-time) ease;
    z-index: -1;
    pointer-events: none;
  }
  .adu-row-link:hover .adu-row::before { background-color: var(--color-accent-5); }

  /* Dashed bottom line, spans only the page grid (cols 1–4). */
  .adu-row::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    border-bottom: var(--grid-line-thickness) var(--grid-line-horizontal-minor-style) var(--grid-line-color);
    pointer-events: none;
  }

  .adu-row__cell { padding: var(--space-2); font-size: var(--font-size-small); }

  .adu-row__thumb {
    display: block;
    aspect-ratio: 16 / 9;
    width: 100%;
    background: var(--color-accent-5);
    overflow: hidden;
  }
  .adu-row__thumb img,
  .adu-row__thumb picture {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .adu-row__thumb-empty {
    width: 100%;
    height: 100%;
    background: var(--color-accent-5);
  }

  /* Drawing flipper — stacked frames (header + drawings) with prev/next zones.
     Shared markup also rendered inside the compare modal (aduCompareTray.njk). */
  .adu-thumb-flipper {
    position: relative;
    aspect-ratio: 16 / 9;
    width: 100%;
    overflow: hidden;
  }
  .adu-thumb-frame { display: none; }
  .adu-thumb-frame.is-active { display: block; }
  .adu-thumb-zone {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    z-index: 2;
  }
  .adu-thumb-zone--prev {
    left: 0;
    cursor: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="%23001489" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter"><line x1="6" y1="12" x2="18" y2="12"/><polyline points="10 6 4 12 10 18"/></svg>') 12 12, auto;
  }
  .adu-thumb-zone--next {
    right: 0;
    cursor: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="%23001489" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter"><line x1="6" y1="12" x2="18" y2="12"/><polyline points="14 6 20 12 14 18"/></svg>') 12 12, auto;
  }
  :root[dark] .adu-thumb-zone--prev {
    cursor: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="%234D6FFF" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter"><line x1="6" y1="12" x2="18" y2="12"/><polyline points="10 6 4 12 10 18"/></svg>') 12 12, auto;
  }
  :root[dark] .adu-thumb-zone--next {
    cursor: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="%234D6FFF" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter"><line x1="6" y1="12" x2="18" y2="12"/><polyline points="14 6 20 12 14 18"/></svg>') 12 12, auto;
  }
  /* No drawings → no flipping; suppress arrow zones entirely. */
  .adu-thumb-flipper[data-single] .adu-thumb-zone {
    display: none;
  }

  .adu-row__name {
    display: inline-block;
    font-size: var(--font-size-base);
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--color-accent-1);
    position: relative;
    z-index: 1;
    transition: color var(--transition-time) ease;
    width: fit-content;
    max-width: 100%;
  }
  .adu-row__name::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: var(--color-accent-1);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--transition-time) ease;
    z-index: -1;
  }
  .adu-row-link:hover .adu-row__name::before { transform: scaleX(1); }
  .adu-row-link:hover .adu-row__name { color: #ffffff; }

  .adu-row__sub {
    display: block;
    margin-top: var(--space-1);
    font-size: var(--font-size-small);
    opacity: 0.7;
  }

  .adu-row__spec-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .adu-row__spec-list--primary {
    font-weight: bold;
    color: var(--color-accent-1);
  }
  .adu-row__spec-list--secondary {
    font-size: var(--font-size-small);
    color: var(--color-accent-2);
    letter-spacing: 0.05em;
  }
  .adu-row__spec-divider {
    margin: var(--space-1) calc(var(--space-2) * -1);
    border-top: var(--grid-line-thickness) var(--grid-line-horizontal-minor-style) var(--grid-line-color);
  }
  .adu-row__spec-label {
    opacity: 0.6;
    font-weight: normal;
  }

  .adu-row__cell--price {
    text-align: right;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }
  .adu-row__cost-pill {
    display: inline-block;
    color: var(--color-accent-1);
    font-size: var(--font-size-small);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: bold;
  }
  .adu-row__cost-pill-label {
    color: var(--color-accent-2);
    font-weight: normal;
    margin-left: var(--space-1);
  }
  .adu-row__cell--price .adu-compare-btn {
    margin-top: auto;
  }
  .adu-row__cell--price .adu-row__sub {
    text-align: left;
    align-self: stretch;
  }

  /* Empty state */
  .adu-empty {
    padding: var(--space-7) var(--space-2);
    text-align: center;
    opacity: 0.6;
    font-size: var(--font-size-small);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Tier section header — 4-col band that introduces each tier group */
  .adu-tier-header {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    scroll-margin-top: 121px;
  }
  @media (min-width: 840px) {
    .adu-tier-header { grid-template-columns: repeat(4, 1fr); }
  }
  .adu-tier-header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    border-top: var(--grid-line-thickness) var(--grid-line-horizontal-major-style) var(--color-accent-1);
    pointer-events: none;
  }
  .adu-tier-header::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    border-bottom: var(--grid-line-thickness) var(--grid-line-horizontal-minor-style) var(--grid-line-color);
    pointer-events: none;
  }
  .adu-tier-header__name-cell {
    grid-column: 1;
    padding: var(--space-2);
  }
  .adu-tier-header__count-cell {
    grid-column: 2;
    padding: var(--space-2);
  }
  .adu-tier-header__count {
    font-size: var(--font-size-small);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .adu-tier-header__count strong { color: var(--color-accent-1); }
  .adu-tier-header__pitch-cell {
    grid-column: 3 / 5;
    padding: var(--space-2);
    font-size: var(--font-size-small);
    line-height: 1.6;
  }
  .adu-tier-header__price-cell {
    grid-column: 4;
    padding: var(--space-2);
    text-align: right;
  }
  @media (max-width: 839px) {
    .adu-tier-header__name-cell,
    .adu-tier-header__count-cell,
    .adu-tier-header__pitch-cell,
    .adu-tier-header__price-cell { grid-column: 1; }
    .adu-tier-header__count-cell,
    .adu-tier-header__pitch-cell,
    .adu-tier-header__price-cell {
      border-top: var(--grid-line-thickness) var(--grid-line-horizontal-minor-style) var(--grid-line-color);
    }
  }
  .adu-tier-header__edition {
    font-size: var(--font-size-small);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent-2);
    margin-bottom: var(--space-1);
  }
  .adu-tier-header__name {
    font-weight: 700;
    color: var(--color-accent-1);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1.1;
  }
  .adu-tier-header__price-label {
    display: block;
    font-size: var(--font-size-small);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent-2);
    margin-bottom: var(--space-1);
  }
  .adu-tier-header__price-amount {
    font-weight: bold;
    color: var(--color-accent-1);
    font-variant-numeric: tabular-nums;
  }
  .adu-tier-header__price-amount small {
    font-size: var(--font-size-small);
    color: var(--color-accent-2);
    font-weight: normal;
    margin-left: var(--space-1);
  }

  /* Per-tier empty state — shown when filters hide every row in a tier */
  .adu-tier-empty {
    padding: var(--space-3) var(--space-2);
    text-align: center;
    opacity: 0.5;
    font-size: var(--font-size-small);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    position: relative;
  }
  .adu-tier-empty::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    border-bottom: var(--grid-line-thickness) var(--grid-line-horizontal-minor-style) var(--grid-line-color);
  }

  /* Page intro — vertical rhythm matches a tier-header cell.
     Horizontal padding is supplied by the inner .grid__item wrapper. */
  .adu-intro {
    position: relative;
    padding: var(--space-5) 0;
  }
  .adu-intro__title {
    color: var(--color-accent-1);
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin-bottom: var(--space-1);
  }
  .adu-intro__description {
    font-size: var(--font-size-small);
    line-height: 1.5;
  }

  /* Tier group breathing room — the rhythm of the page. */
  .adu-tier-group:first-of-type { margin-top: var(--space-7); }
  .adu-tier-group + .adu-tier-group { margin-top: var(--space-7); }

  /* + Compare button — sits below VIEW PROJECT in the price cell.
     Toggles to a solid "✓ ADDED" state via the .is-added class. */
  .adu-compare-btn {
    display: block;
    width: 100%;
    margin-top: var(--space-2);
    background: transparent;
    border: var(--grid-line-thickness) solid var(--color-accent-1);
    color: var(--color-accent-1);
    font: inherit;
    font-size: var(--font-size-small);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: var(--space-1) var(--space-2);
    cursor: pointer;
    transition: background-color var(--transition-time) ease, color var(--transition-time) ease;
  }
  .adu-compare-btn:hover,
  .adu-compare-btn.is-added {
    background: var(--color-accent-1);
    color: #ffffff;
  }

  /* Leave space at the bottom of the page so the fixed tray
     never covers the last row of the catalog. */
  body.has-compare-tray { padding-bottom: 96px; }

  /* "Help me choose" trigger + "× CLOSE" buttons — sit in column 4 of the intro.
     Bottom margin matches the <p> default so the buttons line up with the
     description's bottom edge. CLOSE is hidden until the quiz panel is open. */
  .adu-intro__action-cell {
    align-self: end;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    gap: var(--space-1);
    margin-bottom: var(--space);
  }
  @media (max-width: 839px) {
    .adu-intro__action-cell {
      align-self: auto;
      align-items: flex-start;
      justify-content: flex-start;
      margin-bottom: 0;
    }
  }
  .adu-match-trigger,
  .adu-match-exit {
    background: transparent;
    border: var(--grid-line-thickness) solid var(--color-accent-1);
    color: var(--color-accent-1);
    font: inherit;
    font-size: var(--font-size-small);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: var(--space-1) var(--space-2);
    cursor: pointer;
    transition: background-color var(--transition-time) ease, color var(--transition-time) ease;
  }
  .adu-match-trigger:hover,
  .adu-match-exit:hover {
    background: var(--color-accent-1);
    color: #ffffff;
  }
  .adu-match-exit { display: none; }
  body.is-quizzing .adu-match-exit { display: inline-block; }

  /* Matching mode — flat list, no filter/meta/tier-header chrome. */
  body.is-matching .adu-filters,
  body.is-matching .adu-meta,
  body.is-matching .adu-tier-group,
  body.is-matching .adu-match-trigger { display: none; }

  /* Quiz mode — quiz panel takes over; hide the catalog chrome behind it. */
  body.is-quizzing .adu-filters,
  body.is-quizzing .adu-meta { display: none; }

  /* Top-3 match badge above the row title (rendered only on cloned rows
     inside .adu-match-results). */
  .adu-match-badge {
    display: inline-block;
    background: var(--color-accent-1);
    color: #ffffff;
    font-size: var(--font-size-small);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 1px 6px;
    margin-bottom: var(--space-1);
  }
</style>

<article>

  {# Page title #}
  <section class="adu-intro">
    <div class="grid grid--4">
      <div class="grid__item col-1-2">
        <h1 class="adu-intro__title">ADU LIBRARY</h1>
        <p class="adu-intro__description text--small">Free, downloadable design packets for accessory dwelling units. Browse, click into any scheme to view drawings and download the full design toolkit.</p>
      </div>
      <div class="grid__item col-4 adu-intro__action-cell">
        <button class="adu-match-exit" type="button" id="adu-match-exit" aria-label="Close quiz">× CLOSE</button>
        <button class="adu-match-trigger" type="button" id="adu-match-open">HELP ME CHOOSE →</button>
      </div>
    </div>
  </section>

  {% include "components/aduMatchQuiz.njk" %}

  {# ─────────────────────────────────────────────────────────────
     FILTERS — bedrooms / stair / budget / features
     Filter options are hardcoded; live filtering on the rendered
     rows is done via JS below. Filters that match no rows simply
     produce zero results when toggled — harmless.
     ───────────────────────────────────────────────────────────── #}

  <div class="adu-filters">

    <div class="adu-filter-block">
      <div class="adu-filter-block__heading">BEDROOMS</div>
      <div class="adu-filter-block__list">
        <label class="index-filter"><input type="checkbox" data-filter="bedrooms" data-value="1"><span class="index-filter__box"></span><span class="index-filter__label">1 BR</span></label>
        <label class="index-filter"><input type="checkbox" data-filter="bedrooms" data-value="2"><span class="index-filter__box"></span><span class="index-filter__label">2 BR</span></label>
        <label class="index-filter"><input type="checkbox" data-filter="loft" data-value="true"><span class="index-filter__box"></span><span class="index-filter__label">+ LOFT</span></label>
      </div>
    </div>

    <div class="adu-filter-block">
      <div class="adu-filter-block__heading">STAIR</div>
      <div class="adu-filter-block__list">
        <label class="index-filter"><input type="checkbox" data-filter="stair" data-value="ladder-int"><span class="index-filter__box"></span><span class="index-filter__label">LADDER-INT</span></label>
        <label class="index-filter"><input type="checkbox" data-filter="stair" data-value="full-int"><span class="index-filter__box"></span><span class="index-filter__label">FULL-INT</span></label>
        <label class="index-filter"><input type="checkbox" data-filter="stair" data-value="full-ext"><span class="index-filter__box"></span><span class="index-filter__label">FULL-EXT</span></label>
      </div>
    </div>

    <div class="adu-filter-block">
      <div class="adu-filter-block__heading">COST TIER</div>
      <div class="adu-filter-block__list">
        <label class="index-filter"><input type="checkbox" data-filter="cost_tier" data-value="low"><span class="index-filter__box"></span><span class="index-filter__label">LOW</span></label>
        <label class="index-filter"><input type="checkbox" data-filter="cost_tier" data-value="medium"><span class="index-filter__box"></span><span class="index-filter__label">MEDIUM</span></label>
        <label class="index-filter"><input type="checkbox" data-filter="cost_tier" data-value="high"><span class="index-filter__box"></span><span class="index-filter__label">HIGH</span></label>
      </div>
    </div>

    <div class="adu-filter-block">
      <div class="adu-filter-block__heading">FEATURES</div>
      <div class="adu-filter-block__list">
        <label class="index-filter"><input type="checkbox" data-filter="feature" data-value="loft"><span class="index-filter__box"></span><span class="index-filter__label">LOFT</span></label>
        <label class="index-filter"><input type="checkbox" data-filter="feature" data-value="porch"><span class="index-filter__box"></span><span class="index-filter__label">PORCH</span></label>
        <label class="index-filter"><input type="checkbox" data-filter="feature" data-value="deck"><span class="index-filter__box"></span><span class="index-filter__label">DECK</span></label>
        <label class="index-filter"><input type="checkbox" data-filter="feature" data-value="courtyard"><span class="index-filter__box"></span><span class="index-filter__label">COURTYARD</span></label>
        <label class="index-filter"><input type="checkbox" data-filter="feature" data-value="stair"><span class="index-filter__box"></span><span class="index-filter__label">STAIR</span></label>
      </div>
    </div>

  </div>

  {# Result count + clear, on the 4-col grid #}
  <div class="adu-meta">
    <span class="adu-meta__count">
      <strong id="adu-result-count">{{ collections.aduLibrary.length }}</strong> / {{ collections.aduLibrary.length }} DESIGNS
    </span>
    <button class="adu-meta__clear" id="adu-clear-filters">CLEAR FILTERS</button>
  </div>

  {# ─────────────────────────────────────────────────────────────
     ADU ROWS — grouped by tier. Each tier section is preceded by a
     tier header. Filter logic in JS hides individual rows and the
     per-tier empty state appears when a section's rows are all hidden.
     ───────────────────────────────────────────────────────────── #}

  <div class="adu-rows">

    {% if collections.aduLibrary | length %}
      {% for tier in aduTiers %}
        {% set tierProjects = collections.aduLibrary | aduByTier(tier.name) %}
        {% if tierProjects | length %}
          <div class="adu-tier-group" data-tier-group="{{ tier.name }}">
            {% include "components/aduTierHeader.njk" %}
            {% for project in tierProjects %}
              {% set adu = project.data.adu %}
              <a href="{{ project.url | url }}" class="adu-row-link">
                <div class="adu-row"
                     data-adu
                     data-tier="{{ adu.tier }}"
                     data-bedrooms="{{ adu.bedrooms }}"
                     data-loft="{{ 'true' if adu.loft else 'false' }}"
                     data-stair="{{ adu.stair }}"
                     data-cost-tier="{{ adu.cost_tier }}"
                     data-orientation="{{ adu.orientation }}"
                     data-height="{{ adu.height }}"
                     data-features="{{ adu.features | join(',') if adu.features else '' }}">

                  <div class="adu-row__cell adu-row__cell--thumb">
                    <div class="adu-row__thumb">
                      {% if project.data.headerImage %}
                        {% set outputFormats = [] %}
                        {% for format, i in settings.images %}
                          {% if i.enabled === true %}
                            {{ '' if outputFormats.push(format) }}
                          {% endif %}
                        {% endfor %}
                        {% set drawings = project.data.drawings or [] %}
                        <div class="adu-thumb-flipper" data-flipper{% if drawings | length == 0 %} data-single{% endif %}>
                          <div class="adu-thumb-frame is-active" data-frame="0">
                            {% set params = {
                              "src": project.data.headerImage.src,
                              "r2record": project.data.headerImage,
                              "alt": project.data.headerImage.alt or project.data.title,
                              "loadingType": "lazy",
                              "viewportSizes": "(min-width: 840px) 25vw, 100vw",
                              "outputWidths": [
                                settings.config.image_grid_width_sm,
                                settings.config.image_grid_width_md
                              ],
                              "outputFormats": outputFormats,
                              "outputQualityJpeg": settings.images.jpeg.quality,
                              "outputQualityWebp": settings.images.webp.quality
                            } %}
                            {% generateImage params %}
                          </div>
                          {% for d in drawings %}
                            <div class="adu-thumb-frame" data-frame="{{ loop.index }}">
                              {% set dParams = {
                                "src": d.src,
                                "r2record": d,
                                "alt": d.caption or project.data.title,
                                "loadingType": "lazy",
                                "viewportSizes": "(min-width: 840px) 25vw, 100vw",
                                "outputWidths": [
                                  settings.config.image_grid_width_sm,
                                  settings.config.image_grid_width_md
                                ],
                                "outputFormats": outputFormats,
                                "outputQualityJpeg": settings.images.jpeg.quality,
                                "outputQualityWebp": settings.images.webp.quality
                              } %}
                              {% generateImage dParams %}
                            </div>
                          {% endfor %}
                          <div class="adu-thumb-zone adu-thumb-zone--prev" data-flip-prev aria-hidden="true"></div>
                          <div class="adu-thumb-zone adu-thumb-zone--next" data-flip-next aria-hidden="true"></div>
                        </div>
                      {% else %}
                        <div class="adu-row__thumb-empty"></div>
                      {% endif %}
                    </div>
                  </div>

                  <div class="adu-row__cell">
                    <div class="adu-row__name">{{ project.data.title | upper }}</div>
                    <span class="adu-row__cost-pill">{{ adu | aduPriceRange }} <span class="adu-row__cost-pill-label">COST TIER</span></span>
                  </div>

                  <div class="adu-row__cell">
                    <div class="adu-row__spec-list adu-row__spec-list--primary">
                      <span>{{ adu.bedrooms }} BR / {{ adu.bathrooms or 1 }} BA{% if adu.loft %} + LOFT{% endif %}</span>
                      <span>{{ adu.sqft }} SQFT</span>
                    </div>
                    <div class="adu-row__spec-divider"></div>
                    <div class="adu-row__spec-list adu-row__spec-list--secondary">
                      <span><span class="adu-row__spec-label">FOOTPRINT</span> {{ adu.footprint | upper }}</span>
                      <span><span class="adu-row__spec-label">STAIR</span> {{ adu.stair | aduStairLabel | upper }}</span>
                    </div>
                  </div>

                  <div class="adu-row__cell adu-row__cell--price">
                    <span class="adu-row__sub">{{ project.data.description }}</span>
                    <button class="adu-compare-btn"
                            type="button"
                            data-compare-add="{{ project.fileSlug }}"
                            data-compare-name="{{ project.data.title | upper }}"
                            data-compare-url="{{ project.url | url }}"
                            data-compare-tier="{{ adu.tier | upper }}"
                            data-compare-bedrooms="{{ adu.bedrooms }} BR / {{ adu.bathrooms or 1 }} BA{% if adu.loft %} + LOFT{% endif %}"
                            data-compare-stair="{{ adu.stair | aduStairLabel | upper }}"
                            data-compare-footprint="{{ adu.footprint | upper }}"
                            data-compare-sqft="{{ adu.sqft }}"
                            data-compare-price="{{ adu | aduPriceRange }}"
                            data-compare-orientation="{{ adu.orientation | upper }}"
                            data-compare-height="{{ adu.height | upper }}"
                            data-compare-features="{% if adu.features %}{{ adu.features | join(', ') | upper }}{% endif %}">
                      <span class="adu-compare-btn__label">+ COMPARE</span>
                      {% if project.data.headerImage %}
                      <template class="adu-compare-btn__thumb-tpl">
                        {% set cmpOutputFormats = [] %}
                        {% for format, i in settings.images %}
                          {% if i.enabled === true %}
                            {{ '' if cmpOutputFormats.push(format) }}
                          {% endif %}
                        {% endfor %}
                        {% set cmpDrawings = project.data.drawings or [] %}
                        <div class="adu-thumb-flipper" data-flipper{% if cmpDrawings | length == 0 %} data-single{% endif %}>
                          <div class="adu-thumb-frame is-active" data-frame="0">
                            {% set thumbParams = {
                              "src": project.data.headerImage.src,
                              "r2record": project.data.headerImage,
                              "alt": project.data.headerImage.alt or project.data.title,
                              "loadingType": "lazy",
                              "viewportSizes": "(min-width: 840px) 25vw, 90vw",
                              "outputWidths": [
                                settings.config.image_grid_width_sm,
                                settings.config.image_grid_width_md
                              ],
                              "outputFormats": cmpOutputFormats,
                              "outputQualityJpeg": settings.images.jpeg.quality,
                              "outputQualityWebp": settings.images.webp.quality
                            } %}
                            {% generateImage thumbParams %}
                          </div>
                          {% for d in cmpDrawings %}
                            <div class="adu-thumb-frame" data-frame="{{ loop.index }}">
                              {% set cmpDParams = {
                                "src": d.src,
                                "r2record": d,
                                "alt": d.caption or project.data.title,
                                "loadingType": "lazy",
                                "viewportSizes": "(min-width: 840px) 25vw, 90vw",
                                "outputWidths": [
                                  settings.config.image_grid_width_sm,
                                  settings.config.image_grid_width_md
                                ],
                                "outputFormats": cmpOutputFormats,
                                "outputQualityJpeg": settings.images.jpeg.quality,
                                "outputQualityWebp": settings.images.webp.quality
                              } %}
                              {% generateImage cmpDParams %}
                            </div>
                          {% endfor %}
                          <div class="adu-thumb-zone adu-thumb-zone--prev" data-flip-prev aria-hidden="true"></div>
                          <div class="adu-thumb-zone adu-thumb-zone--next" data-flip-next aria-hidden="true"></div>
                        </div>
                      </template>
                      {% endif %}
                    </button>
                  </div>

                </div>
              </a>
            {% endfor %}
            <div class="adu-tier-empty" data-tier-empty="{{ tier.name }}" style="display:none;">
              No {{ tier.name | upper }} designs match these filters.
            </div>
          </div>
        {% endif %}
      {% endfor %}
    {% else %}
      <div class="adu-empty">The ADU library is being prepared. Check back soon for free, downloadable design packets.</div>
    {% endif %}

  </div>

  {% include "components/aduCompareTray.njk" %}

</article>

{# ─────────────────────────────────────────────────────────────
   Live filtering — show/hide row anchor wrappers based on filter state
   ───────────────────────────────────────────────────────────── #}
<script>
(function () {
  var rows = Array.prototype.slice.call(document.querySelectorAll('.adu-row[data-adu]'));
  var countEl = document.getElementById('adu-result-count');
  var filters = { bedrooms: [], loft: [], stair: [], cost_tier: [], feature: [] };

  function rowMatches(row) {
    if (filters.bedrooms.length && filters.bedrooms.indexOf(row.dataset.bedrooms) < 0) return false;
    if (filters.loft.length && filters.loft.indexOf(row.dataset.loft) < 0) return false;
    if (filters.stair.length && filters.stair.indexOf(row.dataset.stair) < 0) return false;
    if (filters.cost_tier.length && filters.cost_tier.indexOf(row.dataset.costTier) < 0) return false;
    if (filters.feature.length) {
      var rowFeats = (row.dataset.features || '').split(',').filter(Boolean);
      for (var i = 0; i < filters.feature.length; i++) {
        if (rowFeats.indexOf(filters.feature[i]) < 0) return false;
      }
    }
    return true;
  }

  function rerender() {
    var visible = 0;
    // Per-tier visible counters so we can toggle the per-tier empty state.
    var tierCounts = {};
    rows.forEach(function (row) {
      var match = rowMatches(row);
      var wrapper = row.closest('.adu-row-link') || row;
      wrapper.style.display = match ? '' : 'none';
      if (match) visible++;
      var tier = row.dataset.tier;
      if (tier) tierCounts[tier] = (tierCounts[tier] || 0) + (match ? 1 : 0);
    });
    if (countEl) countEl.textContent = visible;
    // Show per-tier empty state when a tier section has zero matches.
    document.querySelectorAll('[data-tier-empty]').forEach(function (el) {
      var t = el.getAttribute('data-tier-empty');
      el.style.display = (tierCounts[t] === 0) ? '' : 'none';
    });
    // Update the per-tier header count ("N / TOTAL DESIGNS").
    document.querySelectorAll('[data-tier-count]').forEach(function (el) {
      var t = el.getAttribute('data-tier-count');
      var strong = el.querySelector('strong');
      if (strong) strong.textContent = tierCounts[t] || 0;
    });
  }

  document.querySelectorAll('.adu-filters input[type="checkbox"]').forEach(function (cb) {
    cb.addEventListener('change', function () {
      var k = cb.dataset.filter;
      var v = cb.dataset.value;
      var arr = filters[k];
      var idx = arr.indexOf(v);
      if (cb.checked && idx < 0) arr.push(v);
      else if (!cb.checked && idx >= 0) arr.splice(idx, 1);
      rerender();
    });
  });

  document.getElementById('adu-clear-filters').addEventListener('click', function () {
    Object.keys(filters).forEach(function (k) { filters[k] = []; });
    document.querySelectorAll('.adu-filters input[type="checkbox"]').forEach(function (cb) { cb.checked = false; });
    rerender();
  });

  rerender();
})();
</script>

{# ── Drawing flipper ──────────────────────────────────────────────────
   Click a thumbnail's right zone to advance every thumbnail under `root`
   to its next drawing at once (left zone steps back). Each flipper wraps
   independently within its own frame count, so schemes with no drawings
   simply stay on their header. Exposed as window.aduThumbFlip so the
   compare modal can drive the same logic on its panel. #}
<script>
(function () {
  // Attach a synced flipper controller to every [data-flipper] inside root.
  // Returns a teardown fn that removes the listeners (used by the modal,
  // which rebuilds its DOM on every open).
  function attach(root) {
    var flippers = Array.prototype.map.call(
      root.querySelectorAll("[data-flipper]"),
      function (el) {
        return { el: el, frames: el.querySelectorAll("[data-frame]") };
      }
    ).filter(function (f) { return f.frames.length > 1; });

    if (!flippers.length) return function () {};

    var shared = 0;

    function show() {
      flippers.forEach(function (f) {
        var len = f.frames.length;
        var idx = ((shared % len) + len) % len;
        for (var n = 0; n < len; n++) {
          f.frames[n].classList.toggle("is-active", n === idx);
        }
      });
    }

    function onClick(e) {
      var next = e.target.closest("[data-flip-next]");
      var prev = e.target.closest("[data-flip-prev]");
      if (!next && !prev) return;
      if (!root.contains(next || prev)) return;
      e.preventDefault();
      e.stopPropagation();
      shared += next ? 1 : -1;
      show();
    }

    root.addEventListener("click", onClick);
    return function () { root.removeEventListener("click", onClick); };
  }

  window.aduThumbFlip = { attach: attach };

  // Drive the library page's own rows.
  attach(document.querySelector(".adu-rows") || document.body);
})();
</script>

