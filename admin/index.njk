---
layout: false
permalink: /admin/index.html
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LowDO Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Overpass+Mono:wght@300..700&display=swap">
  <style>
    {% include "assets/css/admin.css" %}
  </style>
</head>
<body>

  {# Login screen — 4 columns × 5 rows grid #}
  {# Cols: empty | logo | form | empty #}
  {# Rows: spacer | heading | password | button | spacer #}
  <div id="login-screen" class="login-screen">

    {# Explicitly placed content cells #}
    <div class="login-cell login-cell--logo">
      <img src="/assets/uploads/favicon.png" alt="LowDO">
    </div>
    <div class="login-cell login-cell--heading">
      <h1>LowDO Admin</h1>
    </div>
    <div class="login-cell login-cell--password">
      <form id="login-form">
        <input type="password" id="login-password" placeholder="Enter Password" autocomplete="current-password" required>
        <p id="login-error" class="error" hidden></p>
      </form>
    </div>
    <div class="login-cell login-cell--button">
      <button type="submit" form="login-form">Login</button>
    </div>

    {# Auto-placed filler cells to complete the grid (4×5 = 20, minus 4 explicitly-placed cells = 16) #}
    <div class="login-cell"></div>
    <div class="login-cell"></div>
    <div class="login-cell"></div>
    <div class="login-cell"></div>
    <div class="login-cell"></div>
    <div class="login-cell"></div>
    <div class="login-cell"></div>
    <div class="login-cell"></div>
    <div class="login-cell"></div>
    <div class="login-cell"></div>
    <div class="login-cell"></div>
    <div class="login-cell"></div>
    <div class="login-cell"></div>
    <div class="login-cell"></div>
    <div class="login-cell"></div>
    <div class="login-cell"></div>

    {# Lines painted last so they render above cell backgrounds #}
    <div class="login-col-line"></div>
    <div class="login-row-line login-row-line--top"></div>
    <div class="login-row-line login-row-line--bottom"></div>
    <div class="login-row-line login-row-line--heading"></div>
    <div class="login-row-line login-row-line--password"></div>

  </div>

  {# Admin screen #}
  <div id="admin-screen" class="admin-screen" hidden>

    {# Top bar #}
    <header class="admin-header">
      <h1>LowDO Admin</h1>
      <div class="admin-header__actions">
        <span id="change-count" class="change-count" hidden>0 changes</span>
        <button id="clear-btn" class="btn btn--secondary" disabled hidden>Clear Changes</button>
        <button id="save-btn" class="btn btn--primary" disabled>Save Changes</button>
        <button id="logout-btn" class="btn btn--secondary">Logout</button>
      </div>
    </header>

    {# Toolbar #}
    <div class="admin-toolbar">
      <div class="admin-toolbar__draft-filters admin-dropdown" id="draft-filters" data-value="all">
        <button class="admin-dropdown__button" aria-expanded="false" type="button">
          <span class="admin-dropdown__label">STATUS</span>
          <svg class="admin-dropdown__chevron" width="8" height="5" viewBox="0 0 8 5" fill="none" aria-hidden="true">
            <path d="M1 1l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
          </svg>
        </button>
        <div class="admin-dropdown__drawer" aria-hidden="true">
          <button class="admin-dropdown__item is-selected" type="button" data-value="all">ALL</button>
          <button class="admin-dropdown__item" type="button" data-value="draft">DRAFT</button>
          <button class="admin-dropdown__item" type="button" data-value="published">PUBLISHED</button>
        </div>
      </div>
      <div class="admin-toolbar__search-group">
        <div class="admin-toolbar__search">
          <input type="text" id="search-input" placeholder="Search by title or slug...">
        </div>
        <div class="admin-toolbar__categories">
          <div class="admin-dropdown admin-dropdown--multi" id="type-filters">
            <button class="admin-dropdown__button" aria-expanded="false" type="button">
              <span class="admin-dropdown__label">ALL TYPES</span>
              <svg class="admin-dropdown__chevron" width="8" height="5" viewBox="0 0 8 5" fill="none" aria-hidden="true">
                <path d="M1 1l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
              </svg>
            </button>
            <div class="admin-dropdown__drawer" aria-hidden="true">
              <button class="admin-dropdown__item is-selected" type="button" data-value="all">ALL</button>
            </div>
          </div>
          <div class="admin-dropdown admin-dropdown--multi" id="category-filters">
            <button class="admin-dropdown__button" aria-expanded="false" type="button">
              <span class="admin-dropdown__label">ALL CATEGORIES</span>
              <svg class="admin-dropdown__chevron" width="8" height="5" viewBox="0 0 8 5" fill="none" aria-hidden="true">
                <path d="M1 1l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
              </svg>
            </button>
            <div class="admin-dropdown__drawer" aria-hidden="true">
              <button class="admin-dropdown__item is-selected" type="button" data-value="all">ALL</button>
            </div>
          </div>
        </div>
      </div>
      <button id="manage-btn" class="btn btn--small">Manage Labels</button>
      <button id="manage-collaborators-btn" class="btn btn--small">Manage Collaborators</button>
      <div class="admin-toolbar__bulk" id="bulk-actions">
        <button id="bulk-actions-btn" class="btn btn--small"><span id="selected-count">0 selected</span><span>Bulk Actions</span></button>
      </div>
      <button id="new-entry-btn" class="btn btn--secondary">+ New Entry</button>
    </div>

    {# Table #}
    <div class="admin-table-wrap">
      <table class="admin-table" id="entries-table">
        <thead>
          <tr>
            <th class="col-select"><input type="checkbox" id="select-all"></th>
            <th class="col-draft">Draft</th>
            <th class="col-title sortable" data-sort="title">Title</th>
            <th class="col-type sortable" data-sort="entryType">Type</th>
            <th class="col-categories">Categories</th>
            <th class="col-date sortable" data-sort="date">Date</th>
            <th class="col-actions"></th>
          </tr>
        </thead>
        <tbody id="entries-tbody"></tbody>
      </table>
    </div>

    {# Edit panel (modal) #}
    <div id="edit-panel" class="edit-panel" role="dialog" aria-modal="true" aria-labelledby="edit-panel-title" hidden>
      <div class="edit-panel__header">
        <h2 id="edit-panel-title">Edit Entry</h2>
        <button id="edit-panel-close" class="btn btn--secondary">&times;</button>
      </div>
      <div class="edit-panel__body">

        {# Section: Identity #}
        <div class="ep-section">
          <span class="ep-section__label">Identity</span>
          <div class="ep-grid">
            <span class="ep-row__label">Type</span>
            <div class="ep-row__control">
              <div class="admin-dropdown ep-type-dropdown" id="ep-type-dropdown">
                <button class="admin-dropdown__button" aria-expanded="false" type="button">
                  <span class="admin-dropdown__label" id="ep-type-label">—</span>
                  <svg class="admin-dropdown__chevron" width="8" height="5" viewBox="0 0 8 5" fill="none" aria-hidden="true">
                    <path d="M1 1l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
                  </svg>
                </button>
                <div class="admin-dropdown__drawer" aria-hidden="true" id="ep-type-drawer"></div>
              </div>
            </div>
            <span class="ep-row__label">Slug</span>
            <div class="ep-row__control">
              <input type="text" id="ep-slug" placeholder="20260101_project-name">
            </div>
            <span class="ep-row__label">Draft</span>
            <div class="ep-row__control">
              <label class="field-label--inline">
                <input type="checkbox" id="ep-draft"> Draft
              </label>
            </div>
            <span class="ep-row__label staff-only">Active</span>
            <div class="ep-row__control staff-only">
              <label class="field-label--inline">
                <input type="checkbox" id="ep-active"> Active
              </label>
            </div>
          </div>
        </div>

        {# Section: Metadata #}
        <div class="ep-section">
          <span class="ep-section__label">Metadata</span>
          <div class="ep-grid">
            <span class="ep-row__label">Categories</span>
            <div class="ep-row__control">
              <div id="ep-categories-tags" class="tag-list"></div>
              <div class="admin-dropdown ep-category-dropdown" id="ep-category-dropdown">
                <button class="admin-dropdown__button" aria-expanded="false" type="button" id="ep-category-dropdown-btn">
                  <span class="admin-dropdown__label">Add Category</span>
                  <svg class="admin-dropdown__chevron" width="8" height="5" viewBox="0 0 8 5" fill="none" aria-hidden="true">
                    <path d="M1 1l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
                  </svg>
                </button>
                <div class="admin-dropdown__drawer ep-category-drawer" aria-hidden="true" id="ep-category-drawer">
                  <div class="ep-category-search-wrap">
                    <input type="text" id="ep-category-input" placeholder="Filter or create..." autocomplete="off">
                  </div>
                  <div id="ep-category-suggestions" class="tag-list ep-category-tag-list"></div>
                </div>
              </div>
            </div>
            <span class="ep-row__label non-project-only">Link</span>
            <div class="ep-row__control non-project-only">
              <input type="url" id="ep-link" placeholder="https://...">
            </div>
            <span class="ep-row__label project-only">Collaborators</span>
            <div class="ep-row__control project-only">
              <div id="ep-collaborators-list" class="structured-list"></div>
              <button id="ep-add-collaborator" class="btn btn--small">+ Add Collaborator</button>
            </div>
            <span class="ep-row__label">Position</span>
            <div class="ep-row__control">
              <input type="number" id="ep-position" placeholder="999">
            </div>
            <span class="ep-row__label">Date</span>
            <div class="ep-row__control">
              <input type="date" id="ep-date">
            </div>
            <span class="ep-row__label project-only">Year</span>
            <div class="ep-row__control project-only">
              <input type="text" id="ep-year" placeholder="2024 or 2022–Present">
            </div>
            <span class="ep-row__label project-only">Location</span>
            <div class="ep-row__control project-only">
              <input type="text" id="ep-location" placeholder="Austin, TX">
            </div>
            <span class="ep-row__label project-only">Status</span>
            <div class="ep-row__control project-only">
              <div class="tag-input-wrap">
                <input type="text" id="ep-status" placeholder="Built / In Progress / Unbuilt" autocomplete="off">
                <ul id="ep-status-suggestions" class="tag-suggestions" hidden></ul>
              </div>
            </div>
          </div>
        </div>

        {# Section: Content #}
        <div class="ep-section">
          <span class="ep-section__label">Content</span>
          <div class="ep-grid">
            <span class="ep-row__label">Title</span>
            <div class="ep-row__control">
              <input type="text" id="ep-title">
            </div>
            <span class="ep-row__label non-project-only">Subtitle</span>
            <div class="ep-row__control non-project-only">
              <input type="text" id="ep-subtitle">
            </div>
            <span class="ep-row__label">Description</span>
            <div class="ep-row__control">
              <textarea id="ep-description" rows="2"></textarea>
            </div>
            <span class="ep-row__label">Body</span>
            <div class="ep-row__control">
              <div class="ep-body-toolbar">
                <button type="button" class="btn btn--small ep-fmt-btn" data-fmt="bold" title="Bold"><strong>B</strong></button>
                <button type="button" class="btn btn--small ep-fmt-btn" data-fmt="italic" title="Italic"><em>I</em></button>
                <button type="button" class="btn btn--small ep-fmt-btn" data-fmt="h2" title="Heading">H2</button>
                <button type="button" class="btn btn--small ep-fmt-btn" data-fmt="ul" title="Bullet list">&#8226; List</button>
                <button type="button" class="btn btn--small ep-fmt-btn" data-fmt="link" title="Link">&#9741; Link</button>
              </div>
              <div id="ep-body" class="ep-body-editor" contenteditable="true" data-placeholder="Write body text here..."></div>
            </div>
          </div>
        </div>

        {# Section: Relations #}
        <div class="ep-section">
          <span class="ep-section__label">Relations</span>
          <div class="ep-grid">
            <span class="ep-row__label project-only">Featured</span>
            <div class="ep-row__control project-only">
              <label class="field-label--inline">
                <input type="checkbox" id="ep-featured"> Featured on homepage
              </label>
            </div>
            <span class="ep-row__label project-only ep-featured-position-row" hidden>Featured position</span>
            <div class="ep-row__control project-only ep-featured-position-row" hidden>
              <input type="number" id="ep-featured-position" min="1" placeholder="1">
            </div>
            <span class="ep-row__label non-project-only">Awards</span>
            <div class="ep-row__control non-project-only">
              <label class="field-label--inline">
                <input type="checkbox" id="ep-show-in-awards-table"> Awards &amp; Recognition section
              </label>
            </div>
            <span class="ep-row__label project-only">Related entries</span>
            <div class="ep-row__control project-only">
              <div id="ep-related-entries-list" class="tag-list"></div>
              <div class="tag-input-wrap">
                <input type="text" id="ep-related-entries-input" placeholder="Search entries by title or slug..." autocomplete="off">
                <ul id="ep-related-entries-suggestions" class="tag-suggestions" hidden></ul>
              </div>
            </div>
            <span class="ep-row__label non-project-only">Related projects</span>
            <div class="ep-row__control non-project-only">
              <div id="ep-related-projects-list" class="tag-list"></div>
              <div class="tag-input-wrap">
                <input type="text" id="ep-related-project-input" placeholder="Search projects by slug...">
                <ul id="ep-related-project-suggestions" class="tag-suggestions" hidden></ul>
              </div>
            </div>
          </div>
        </div>

      </div>
      <div class="edit-panel__footer">
        <button id="ep-apply-btn" class="btn btn--primary">Apply Changes</button>
        <button id="edit-panel-close-footer" class="btn btn--secondary">Cancel</button>
      </div>
    </div>
    <div id="edit-panel-backdrop" class="edit-panel-backdrop" hidden></div>

    {# Bulk category modal #}
    <div id="bulk-modal" class="modal" hidden>
      <div class="modal-content modal-content--table">
        <div class="manage-header">
          <h3>Bulk Actions</h3>
          <div class="manage-tabs">
            <button id="bulk-tab-add" class="manage-tab is-active" type="button">+ Add Category</button>
            <button id="bulk-tab-remove" class="manage-tab" type="button">− Remove Category</button>
          </div>
        </div>
        <div class="bulk-body">
          <div class="bulk-entries-col">
            <table class="admin-table manage-table" id="bulk-entries-table">
              <thead>
                <tr>
                  <th class="bulk-col-title">Entry</th>
                  <th class="bulk-col-categories">Categories</th>
                </tr>
              </thead>
              <tbody id="bulk-entries-body"></tbody>
            </table>
          </div>
          <div class="bulk-category-col">
            <input type="text" id="bulk-category-input" placeholder="Category name...">
            <ul id="bulk-category-suggestions"></ul>
          </div>
        </div>
        <div class="manage-footer">
          <p class="manage-hint">Changes apply to all selected entries.</p>
          <div class="manage-footer__actions">
            <button id="bulk-modal-confirm" class="btn btn--primary">Apply</button>
            <button id="bulk-modal-cancel" class="btn btn--secondary">Cancel</button>
          </div>
        </div>
      </div>
    </div>

    {# Manage labels modal (rename categories + types) #}
    <div id="manage-modal" class="modal" hidden>
      <div class="modal-content modal-content--table">
        <div class="manage-header">
          <h3>Manage Labels</h3>
          <div class="manage-tabs">
            <button class="manage-tab is-active" data-tab="types">Types</button>
            <button class="manage-tab" data-tab="categories">Categories</button>
          </div>
        </div>
        <div id="manage-categories-panel" class="manage-panel" hidden>
          <table class="admin-table manage-table" id="manage-categories-list">
            <thead>
              <tr>
                <th class="manage-col-select"></th>
                <th class="manage-col-label">Label</th>
                <th class="manage-col-count">Entries</th>
                <th class="manage-col-actions"></th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
        <div id="manage-types-panel" class="manage-panel">
          <table class="admin-table manage-table" id="manage-types-list">
            <thead>
              <tr>
                <th class="manage-col-select"></th>
                <th class="manage-col-label">Label</th>
                <th class="manage-col-count">Entries</th>
                <th class="manage-col-actions"></th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
        <div class="manage-footer">
          <p class="manage-hint">Renames and deletes apply when you save changes.</p>
          <div class="manage-footer__actions">
            <button id="manage-combine-btn" class="btn btn--secondary" hidden>Combine 0 Labels</button>
            <button id="manage-modal-close" class="btn btn--secondary">Done</button>
          </div>
        </div>
      </div>
    </div>

    {# Save confirmation modal #}
    <div id="save-confirm-modal" class="modal" hidden>
      <div class="modal-content modal-content--table modal-content--save-confirm">
        <div class="manage-header">
          <h3>Confirm Changes</h3>
        </div>
        <div class="manage-panel">
          <table class="admin-table manage-table save-confirm-table">
            <thead>
              <tr>
                <th class="sct-col-entry">Entry</th>
                <th class="sct-col-action">Action</th>
                <th class="sct-col-field">Field</th>
                <th class="sct-col-old">Before</th>
                <th class="sct-col-new">After</th>
              </tr>
            </thead>
            <tbody id="save-confirm-tbody"></tbody>
          </table>
        </div>
        <div class="manage-footer">
          <div class="manage-footer__actions">
            <button id="save-confirm-btn" class="btn btn--primary">Save Changes</button>
            <button id="save-confirm-cancel" class="btn btn--secondary">Cancel</button>
          </div>
        </div>
      </div>
    </div>

    {# Clear changes confirmation modal #}
    <div id="clear-modal" class="modal" hidden>
      <div class="modal-content">
        <h3>Clear Changes</h3>
        <p>Discard all unsaved changes and revert to the last saved state?</p>
        <div class="modal-actions">
          <button id="clear-modal-confirm" class="btn btn--primary btn--danger-solid">Discard Changes</button>
          <button id="clear-modal-cancel" class="btn btn--secondary">Cancel</button>
        </div>
      </div>
    </div>

    {# Delete confirmation modal #}
    <div id="delete-modal" class="modal" hidden>
      <div class="modal-content">
        <h3>Delete Entry</h3>
        <p id="delete-modal-msg"></p>
        <div class="modal-actions">
          <button id="delete-modal-confirm" class="btn btn--primary btn--danger-solid">Delete</button>
          <button id="delete-modal-cancel" class="btn btn--secondary">Cancel</button>
        </div>
      </div>
    </div>

    {# Link insertion mini-modal #}
    <div id="link-modal" class="modal" hidden>
      <div class="modal-content modal-content--link">
        <h3>Insert Link</h3>
        <label class="link-modal-label">Text
          <input type="text" id="link-modal-text" placeholder="Link text">
        </label>
        <label class="link-modal-label">URL
          <input type="url" id="link-modal-url" placeholder="https://...">
        </label>
        <div class="modal-actions">
          <button id="link-modal-confirm" class="btn btn--primary">Insert</button>
          <button id="link-modal-cancel" class="btn btn--secondary">Cancel</button>
        </div>
      </div>
    </div>

    {# Save status overlay #}
    <div id="save-overlay" class="save-overlay" hidden>
      <div class="save-overlay__content">
        <p id="save-status">Saving...</p>
      </div>
    </div>

  </div>

  {# Embed entry data at build time — includes ALL entries (draft + published) #}
  <script>
    window.__ENTRIES__ = [
      {%- for entry in collections.allEntries %}
      {
        slug: {{ entry.fileSlug | dump | safe }},
        title: {{ (entry.data.title or null) | dump | safe }},
        subtitle: {{ (entry.data.subtitle or null) | dump | safe }},
        description: {{ (entry.data.description or null) | dump | safe }},
        entryType: {{ (entry.data.entryType or null) | dump | safe }},
        categories: {{ (entry.data.categories or []) | dump | safe }},
        date: {{ (entry.data.date or null) | dump | safe }},
        year: {{ (entry.data.year or null) | dump | safe }},
        location: {{ (entry.data.location or null) | dump | safe }},
        status: {{ (entry.data.status or null) | dump | safe }},
        link: {{ (entry.data.link or null) | dump | safe }},
        position: {{ (entry.data.position or null) | dump | safe }},
        draft: {{ (entry.data.draft or false) | dump | safe }},
        featured: {{ (entry.data.featured or false) | dump | safe }},
        featuredPosition: {{ (entry.data.featuredPosition or null) | dump | safe }},
        showInAwardsTable: {{ (entry.data.showInAwardsTable or false) | dump | safe }},
        active: {{ (entry.data.active if entry.data.active is defined else true) | dump | safe }},
        collaborators: {{ (entry.data.collaborators or []) | dump | safe }},
        relatedProjects: {{ (entry.data.relatedProjects or []) | dump | safe }},
        body: {{ (entry.rawInput | markdownBody or "") | dump | safe }},
        filePath: {{ entry.inputPath | replace("./", "") | dump | safe }}
      },
      {%- endfor %}
    ];

    window.__ENTRY_TYPES__ = {{ collections.allEntryTypes | dump | safe }};
    window.__CATEGORIES__ = {{ canonicalCategories | dump | safe }};
    window.__PROJECT_SLUGS__ = [
      {%- for entry in collections.allEntries %}
      {%- if entry.data.entryType == "project" %}
      {{ entry.fileSlug | dump | safe }},
      {%- endif %}
      {%- endfor %}
    ];
    window.__NON_PROJECT_ENTRIES__ = [
      {%- for entry in collections.allEntries %}
      {%- if entry.data.entryType != "project" %}
      { slug: {{ entry.fileSlug | dump | safe }}, title: {{ (entry.data.title or entry.fileSlug) | dump | safe }} },
      {%- endif %}
      {%- endfor %}
    ];
  </script>

  <script>
    {% include "assets/js/admin.js" %}
  </script>

</body>
</html>
