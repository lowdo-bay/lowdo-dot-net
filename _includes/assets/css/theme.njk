:root {
	--space-scale: {{ settings.theme.theme_layout.space_scale or "100" }};
	--color-text: {{ settings.theme.theme_colors.text or "#000000" }};
  --color-link: {{ settings.theme.theme_colors.link or "#000000" }};
	--color-background: {{ settings.theme.theme_colors.background or "#ffffff" }};
	--font:
	{% if (settings.theme.theme_typography.font == "system" or settings.theme.theme_typography.font == "") %}
		{{ settings.config.font_stack_system | safe }}
	{% else %}
		{{ settings.theme.theme_typography.font }}
	{% endif %};
  --font-weight: {{ settings.theme.theme_typography.font_weight or "400" }};
  --font-scale: {{ settings.theme.theme_typography.font_scale or "100" }};
	--line-height-scale: {{ settings.theme.theme_typography.line_height_scale or "100" }};
	--link-underline: {{ "underline" if settings.theme.theme_typography.link_underline else "none" }};
  --transition-time: {{ settings.theme.theme_features.transition_duration or "300" }}ms;
	/* Grid lines - spreadsheet style */
	--grid-line-color: {{ settings.theme.theme_grid_lines.color or "#001489" }};
	--grid-line-thickness: {{ settings.theme.theme_grid_lines.thickness or 1 }}px;
	--grid-line-vertical-style: {{ settings.theme.theme_grid_lines.vertical_style or "dashed" }};
	--grid-line-horizontal-major-style: {{ settings.theme.theme_grid_lines.horizontal_major_style or "solid" }};
	--grid-line-horizontal-minor-style: {{ settings.theme.theme_grid_lines.horizontal_minor_style or "dashed" }};
	/* Content margin and grid calculations */
	/* Semantic spacing scale - automatically scales with --space at breakpoints */
	--space-0: 0;
	--space-1: calc(var(--space) * 0.25);   /* 0.25rem mobile, 0.375rem desktop */
	--space-2: calc(var(--space) * 0.5);    /* 0.5rem mobile, 0.75rem desktop */
	--space-3: var(--space);                /* 1rem mobile, 1.5rem desktop */
	--space-4: calc(var(--space) * 1.5);    /* 1.5rem mobile, 2.25rem desktop */
	--space-5: calc(var(--space) * 2);      /* 2rem mobile, 3rem desktop */
	--space-6: calc(var(--space) * 3);      /* 3rem mobile, 4.5rem desktop */
	--space-7: calc(var(--space) * 4);      /* 4rem mobile, 6rem desktop */
	--space-8: calc(var(--space) * 6);      /* 6rem mobile, 9rem desktop */
	--space-9: calc(var(--space) * 8);      /* 8rem mobile, 12rem desktop */

	--content-margin: var(--space-5);
	--grid-gap: 0;

	/* Viewport-based calculations for precise grid */
	--content-width: calc(100vw - 2 * var(--content-margin));
	--col-width: calc((var(--content-width) - 3 * var(--grid-gap)) / 4);

	/* Legacy variable for backwards compatibility */
	--grid-col: var(--col-width);

	/* Line positions within content area (for body::after pseudo-element) */
	/* Lines positioned at column boundaries (right edge of each column) */
	/* With grid-gap: 0, columns are exactly 25% each */
	--line-pos-1: 0%;
	--line-pos-2: 25%;
	--line-pos-3: 50%;
	--line-pos-4: 75%;
	--line-pos-5: 100%;

	/* Hamburger menu fixed position - centered in index page's 4th column (96.875% of content width) */
	--hamburger-left: calc(var(--content-margin) + var(--content-width) * 0.96875);
}

:root[dark] {
	--color-text: {{ settings.theme.theme_colors.text_dark or "#ffffff" }};
  --color-link: {{ settings.theme.theme_colors.link_dark or "#ffffff" }};
	--color-background: {{ settings.theme.theme_colors.background_dark or "#001489" }};
	--grid-line-color: {{ settings.theme.theme_grid_lines.color_dark or "#4a5568" }};
}