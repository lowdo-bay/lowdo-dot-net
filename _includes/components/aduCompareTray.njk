{# ─────────────────────────────────────────────────────────────────────
   ADU COMPARE TRAY — fixed-bottom selector + in-place spreadsheet diff.
   Drop this once at the bottom of /adu-library/. State lives in
   sessionStorage; data displayed in the comparison panel is captured
   from the row buttons' data-* attributes at click time.
   ───────────────────────────────────────────────────────────────────── #}
<style>
  /* Scrim covers the page including the site header when the panel is open. */
  .adu-compare-scrim {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.35);
    z-index: 1000;
  }

  .adu-compare-tray {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1001;
    background: var(--color-background);
  }
  .adu-compare-tray::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    border-top: var(--grid-line-thickness) var(--grid-line-horizontal-major-style) var(--color-accent-1);
    pointer-events: none;
  }

  /* Inner wrapper aligns with the page's 4-col content grid. */
  .adu-compare-tray__inner {
    max-width: var(--max-content-width);
    margin: 0 auto;
    padding: 0 var(--content-margin);
    display: grid;
    grid-template-columns: 1fr;
    position: relative;
  }
  @media (min-width: 840px) {
    .adu-compare-tray__inner { grid-template-columns: repeat(4, 1fr); }
  }

  .adu-compare-tray__slot {
    padding: var(--space-2);
    font-size: var(--font-size-small);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 3rem;
  }
  @media (min-width: 840px) {
    .adu-compare-tray__slot[data-slot="0"] { grid-column: 2; grid-row: 1; }
    .adu-compare-tray__slot[data-slot="1"] { grid-column: 3; grid-row: 1; }
    .adu-compare-tray__slot[data-slot="2"] { grid-column: 4; grid-row: 1; }
  }
  @media (max-width: 839px) {
    .adu-compare-tray__slot {
      border-bottom: var(--grid-line-thickness) var(--grid-line-horizontal-minor-style) var(--grid-line-color);
    }
  }
  .adu-compare-tray__slot-name {
    flex: 1;
    font-weight: bold;
    color: var(--color-accent-1);
  }
  .adu-compare-tray__slot-empty {
    flex: 1;
    color: var(--color-accent-2);
    font-style: italic;
  }
  .adu-compare-tray__slot-remove {
    background: none;
    border: none;
    color: var(--color-accent-1);
    font-size: var(--font-size-base);
    line-height: 1;
    cursor: pointer;
    padding: 0 var(--space-1);
  }
  .adu-compare-tray__slot-remove:hover { color: var(--color-accent-2); }

  .adu-compare-tray__actions {
    grid-column: 1;
    grid-row: 1;
    padding: var(--space-2);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-1);
    align-items: center;
  }

  .adu-compare-tray__clear,
  .adu-compare-tray__compare {
    width: 100%;
    font: inherit;
    font-size: var(--font-size-small);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: var(--space-1) var(--space-2);
    cursor: pointer;
    border: var(--grid-line-thickness) solid var(--color-accent-1);
  }
  .adu-compare-tray__clear {
    background: transparent;
    color: var(--color-accent-1);
  }
  .adu-compare-tray__clear:hover {
    background: var(--color-accent-1);
    color: #ffffff;
  }
  .adu-compare-tray__compare {
    background: var(--color-accent-1);
    color: #ffffff;
  }
  .adu-compare-tray__compare:disabled {
    opacity: 0.4;
    pointer-events: none;
    cursor: not-allowed;
  }

  /* Expanded comparison panel */
  .adu-compare-panel {
    max-height: 70vh;
    overflow-y: auto;
    background: var(--color-background);
  }
  .adu-compare-panel__header {
    position: sticky;
    top: 0;
    z-index: 1;
    background: var(--color-background);
    max-width: var(--max-content-width);
    margin: 0 auto;
    padding: 0 var(--content-margin);
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
  }
  @media (min-width: 840px) {
    .adu-compare-panel__header { grid-template-columns: repeat(4, 1fr); }
  }
  .adu-compare-panel__header::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    border-bottom: var(--grid-line-thickness) var(--grid-line-horizontal-major-style) var(--color-accent-1);
    pointer-events: none;
  }
  .adu-compare-panel__title {
    grid-column: 1 / 3;
    padding: var(--space-2);
    color: var(--color-accent-1);
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .adu-compare-panel__close {
    grid-column: 4;
    justify-self: end;
    margin: var(--space-2);
    background: transparent;
    color: var(--color-accent-1);
    border: var(--grid-line-thickness) solid var(--color-accent-1);
    font: inherit;
    font-size: var(--font-size-small);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: var(--space-1) var(--space-2);
    cursor: pointer;
  }
  .adu-compare-panel__close:hover {
    background: var(--color-accent-1);
    color: #ffffff;
  }
  @media (max-width: 839px) {
    .adu-compare-panel__title { grid-column: 1; }
    .adu-compare-panel__close { grid-column: 2; }
  }

  .adu-compare-panel__body {
    max-width: var(--max-content-width);
    margin: 0 auto;
    padding: 0 var(--content-margin);
  }

  /* Comparison table — always uses the page's 4-col grid.
     Label cell occupies col 1; ADU value cells take cols 2..N+1
     (cols 3/4 stay empty when only 2 ADUs are selected). */
  .adu-compare-table { display: block; }
  .adu-compare-row {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
  }
  @media (min-width: 840px) {
    .adu-compare-row { grid-template-columns: repeat(4, 1fr); }
  }
  .adu-compare-row::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    border-bottom: var(--grid-line-thickness) var(--grid-line-horizontal-minor-style) var(--grid-line-color);
    pointer-events: none;
  }
  .adu-compare-row--head::after {
    border-bottom: var(--grid-line-thickness) var(--grid-line-horizontal-major-style) var(--color-accent-1);
  }
  .adu-compare-row:last-of-type::after {
    border-bottom: var(--grid-line-thickness) var(--grid-line-horizontal-major-style) var(--color-accent-1);
  }
  .adu-compare-cell {
    padding: var(--space-2);
    font-size: var(--font-size-small);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .adu-compare-cell--label {
    color: var(--color-accent-1);
    font-weight: bold;
    letter-spacing: 0.05em;
  }
  .adu-compare-cell--name {
    font-size: var(--font-size-base);
  }
  .adu-compare-cell--name a {
    color: var(--color-accent-1);
    font-weight: bold;
    text-decoration: none;
  }
  .adu-compare-cell--name a:hover { text-decoration: underline; }

  /* Thumbnail row */
  .adu-compare-cell--thumb { padding: var(--space-2); }
  .adu-compare-thumb {
    display: block;
    aspect-ratio: 16 / 9;
    width: 100%;
    background: var(--color-accent-5);
    overflow: hidden;
  }
  .adu-compare-thumb picture,
  .adu-compare-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .adu-compare-thumb--empty { background: var(--color-accent-5); }

  /* Mobile: stack rows; label inlines before each value. */
  @media (max-width: 839px) {
    .adu-compare-row { display: block; }
    .adu-compare-row--head .adu-compare-cell--label { display: none; }
    .adu-compare-cell {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: var(--space-2);
    }
    .adu-compare-cell[data-label]::before {
      content: attr(data-label);
      color: var(--color-accent-2);
      font-weight: bold;
      letter-spacing: 0.05em;
    }
  }
</style>

<div class="adu-compare-scrim" id="adu-compare-scrim" hidden></div>

<div class="adu-compare-tray" id="adu-compare-tray" data-max="3" hidden>
  {# Expanded panel — hidden until "Compare →" is clicked #}
  <div class="adu-compare-panel" id="adu-compare-panel" hidden>
    <div class="adu-compare-panel__header">
      <span class="adu-compare-panel__title">SIDE-BY-SIDE COMPARISON</span>
      <button class="adu-compare-panel__close" id="adu-compare-collapse" type="button">× CLOSE</button>
    </div>
    <div class="adu-compare-panel__body" id="adu-compare-panel-body"></div>
  </div>

  {# Slot rail — always visible when tray is active #}
  <div class="adu-compare-tray__inner">
    <div class="adu-compare-tray__slot" data-slot="0"></div>
    <div class="adu-compare-tray__slot" data-slot="1"></div>
    <div class="adu-compare-tray__slot" data-slot="2"></div>
    <div class="adu-compare-tray__actions">
      <button class="adu-compare-tray__compare" id="adu-compare-open" type="button" disabled>COMPARE →</button>
      <button class="adu-compare-tray__clear" id="adu-compare-clear" type="button">CLEAR</button>
    </div>
  </div>
</div>

<script>
(function () {
  const STORAGE_KEY = "lowdo-adu-compare";
  const MAX = 3;

  const ATTRS = [
    { key: "tier",        label: "TIER" },
    { key: "bedrooms",    label: "BED/BATH" },
    { key: "stair",       label: "STAIR" },
    { key: "footprint",   label: "FOOTPRINT" },
    { key: "sqft",        label: "SQFT" },
    { key: "price",       label: "COST TIER" },
    { key: "orientation", label: "ORIENTATION" },
    { key: "height",      label: "HEIGHT" },
    { key: "features",    label: "FEATURES" }
  ];

  const tray  = document.getElementById("adu-compare-tray");
  const scrim = document.getElementById("adu-compare-scrim");
  const panel = document.getElementById("adu-compare-panel");
  const body  = document.getElementById("adu-compare-panel-body");
  const openBtn  = document.getElementById("adu-compare-open");
  const clearBtn = document.getElementById("adu-compare-clear");
  const closeBtn = document.getElementById("adu-compare-collapse");

  const load = () => { try { return JSON.parse(sessionStorage.getItem(STORAGE_KEY) || "[]"); } catch (e) { return []; } };
  const save = (items) => sessionStorage.setItem(STORAGE_KEY, JSON.stringify(items));
  const esc  = (s) => String(s == null ? "" : s).replace(/[&<>"']/g, (c) => ({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[c]));

  let state = load();

  function extractThumb(btn) {
    const tpl = btn && btn.querySelector(".adu-compare-btn__thumb-tpl");
    if (!tpl) return "";
    // <template>.content is a DocumentFragment; serialize via a wrapper div.
    if (tpl.content && tpl.content.firstElementChild) {
      const wrap = document.createElement("div");
      wrap.appendChild(tpl.content.cloneNode(true));
      return wrap.innerHTML;
    }
    return tpl.innerHTML || "";
  }

  function captureFromBtn(btn) {
    const out = {
      slug: btn.dataset.compareAdd,
      name: btn.dataset.compareName || "",
      url:  btn.dataset.compareUrl  || "#"
    };
    ATTRS.forEach((a) => {
      const dsKey = "compare" + a.key.charAt(0).toUpperCase() + a.key.slice(1);
      out[a.key] = btn.dataset[dsKey] || "";
    });
    out.thumbHtml = extractThumb(btn);
    return out;
  }

  // Migrate older entries that don't have thumbHtml yet — look up the
  // matching button on this page and capture its thumbnail.
  function hydrateThumbs() {
    let mutated = false;
    state.forEach((item) => {
      if (item.thumbHtml) return;
      const btn = document.querySelector(`[data-compare-add="${CSS.escape(item.slug)}"]`);
      if (!btn) return;
      const html = extractThumb(btn);
      if (html) { item.thumbHtml = html; mutated = true; }
    });
    if (mutated) save(state);
  }
  hydrateThumbs();

  function toggle(btn) {
    const slug = btn.dataset.compareAdd;
    const idx = state.findIndex((s) => s.slug === slug);
    if (idx >= 0) state.splice(idx, 1);
    else if (state.length < MAX) state.push(captureFromBtn(btn));
    save(state); render();
  }

  function render() {
    document.querySelectorAll("[data-compare-add]").forEach((b) => {
      const isAdded = state.some((s) => s.slug === b.dataset.compareAdd);
      b.classList.toggle("is-added", isAdded);
      b.textContent = isAdded ? "✓ ADDED" : "+ COMPARE";
    });

    if (state.length === 0) {
      tray.hidden = true;
      document.body.classList.remove("has-compare-tray");
      collapsePanel();
      return;
    }
    tray.hidden = false;
    document.body.classList.add("has-compare-tray");

    [0, 1, 2].forEach((i) => {
      const slot = tray.querySelector(`[data-slot="${i}"]`);
      const item = state[i];
      slot.innerHTML = item
        ? `<span class="adu-compare-tray__slot-name">${esc(item.name)}</span>` +
          `<button class="adu-compare-tray__slot-remove" data-remove="${esc(item.slug)}" aria-label="Remove">×</button>`
        : `<span class="adu-compare-tray__slot-empty">SLOT ${i + 1} · EMPTY</span>`;
    });

    openBtn.disabled = state.length < 2;
    if (!panel.hidden) renderPanel();
  }

  function renderPanel() {
    const cols = state.length;
    let html = `<div class="adu-compare-table" style="--compare-cols:${cols};">`;

    // Thumbnail row — uses the pre-rendered <picture> markup from each row button.
    html += `<div class="adu-compare-row adu-compare-row--thumbs">`;
    html += `<div class="adu-compare-cell adu-compare-cell--label">DESIGN</div>`;
    state.forEach((item) => {
      const thumb = item.thumbHtml
        ? `<div class="adu-compare-thumb">${item.thumbHtml}</div>`
        : `<div class="adu-compare-thumb adu-compare-thumb--empty"></div>`;
      html += `<div class="adu-compare-cell adu-compare-cell--thumb" data-label="DESIGN">${thumb}</div>`;
    });
    html += `</div>`;

    // Name row
    html += `<div class="adu-compare-row adu-compare-row--head">`;
    html += `<div class="adu-compare-cell adu-compare-cell--label">NAME</div>`;
    state.forEach((item) => {
      html += `<div class="adu-compare-cell adu-compare-cell--name" data-label="NAME"><a href="${esc(item.url)}">${esc(item.name)}</a></div>`;
    });
    html += `</div>`;
    ATTRS.forEach((a) => {
      html += `<div class="adu-compare-row">`;
      html += `<div class="adu-compare-cell adu-compare-cell--label">${a.label}</div>`;
      state.forEach((item) => {
        html += `<div class="adu-compare-cell" data-label="${a.label}">${esc(item[a.key]) || "—"}</div>`;
      });
      html += `</div>`;
    });
    html += `</div>`;
    body.innerHTML = html;
  }

  function expandPanel() {
    if (state.length < 2) return;
    renderPanel();
    panel.hidden = false;
    scrim.hidden = false;
    document.body.style.overflow = "hidden";
  }
  function collapsePanel() {
    panel.hidden = true;
    scrim.hidden = true;
    document.body.style.overflow = "";
  }

  document.addEventListener("click", (e) => {
    const addBtn = e.target.closest("[data-compare-add]");
    if (addBtn) { e.preventDefault(); e.stopPropagation(); toggle(addBtn); return; }
    const rmBtn = e.target.closest("[data-remove]");
    if (rmBtn) {
      const slug = rmBtn.dataset.remove;
      state = state.filter((s) => s.slug !== slug);
      save(state); render();
      return;
    }
  });

  clearBtn.addEventListener("click", () => { state = []; save(state); render(); });
  openBtn.addEventListener("click", expandPanel);
  closeBtn.addEventListener("click", collapsePanel);
  scrim.addEventListener("click", collapsePanel);
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !panel.hidden) collapsePanel(); });

  render();
})();
</script>
