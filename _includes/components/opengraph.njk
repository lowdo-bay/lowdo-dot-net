{% if page.url == "/" %}
  <meta property="og:title" content="{{ settings.metadata.seo.site_title or settings.metadata.site_title }}" data-helmet>
  <meta property="og:description" content="{{ settings.metadata.seo.site_description or settings.metadata.site_description }}" data-helmet>
{% else %}
  <meta property="og:title" content="{{ seo.title or title }}" data-helmet>
  <meta property="og:description" content="{{ seo.description or description }}" data-helmet>
{% endif %}

<meta property="og:type" content="website" data-helmet>
<meta property="og:site_name" content="{{ settings.metadata.site_title }}" data-helmet>

{% set pageURL = settings.metadata.site_url + page.url %}
<meta property="og:url" content="{{ pageURL }}" data-helmet>

{# Share image: the page's own header image, else the site default #}
{% set ogImg = headerImage if (headerImage and headerImage.src) else settings.metadata.site_og_image %}
{% if ogImg and ogImg.src %}
<meta property="og:image" content="{{ ogImg | r2url(settings.metadata.site_url) }}" data-helmet>
{% if ogImg.width %}<meta property="og:image:width" content="{{ ogImg.width }}" data-helmet>{% endif %}
{% if ogImg.height %}<meta property="og:image:height" content="{{ ogImg.height }}" data-helmet>{% endif %}
<meta property="og:image:alt" content="{{ ogImg.alt or title or settings.metadata.site_title }}" data-helmet>
<meta name="twitter:card" content="summary_large_image" data-helmet>
{% else %}
<meta name="twitter:card" content="summary" data-helmet>
{% endif %}
