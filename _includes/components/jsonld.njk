{# JSON-LD Structured Data for SEO #}
{# Appended to <head> during build via Helmet plugin #}

{% set siteUrl = settings.metadata.site_url %}
{% set siteName = settings.metadata.site_title %}
{% set siteDescription = settings.metadata.seo.site_description or settings.metadata.site_description %}

{# Organization entity — used on the home page and as the About page's mainEntity.
   Contact details, profiles and founders live in settings.yaml. #}
{% set addr = settings.metadata.site_address %}
{% set founders = [] %}
{% for f in settings.metadata.site_founders %}
  {% set founders = (founders.push({
    "@type": "Person",
    "@id": siteUrl + "/about/#" + (f.name | slug),
    "url": siteUrl + "/about/#" + (f.name | slug),
    "name": f.name,
    "jobTitle": f.title,
    "worksFor": { "@type": "Organization", "name": "Low Design Office" },
    "sameAs": f.profiles
  }), founders) %}
{% endfor %}
{# Current staff (active staff entries), each anchored to its row on the About page #}
{% set staff = [] %}
{% for person in collections.entries %}
  {% if person.data.entryType == "staff" and person.data.active == true %}
    {% set personName = person.data.title | replace(", AIA", "") | replace(", GhIE", "") %}
    {% set staff = (staff.push({
      "@type": "Person",
      "@id": siteUrl + "/about/#" + (personName | slug),
      "url": siteUrl + "/about/#" + (personName | slug),
      "name": personName,
      "jobTitle": person.data.subtitle,
      "worksFor": { "@id": siteUrl + "/#organization" }
    }), staff) %}
  {% endif %}
{% endfor %}

{% set organizationSchema = {
  "@context": "https://schema.org",
  "@type": ["Organization", "ProfessionalService"],
  "@id": siteUrl + "/#organization",
  "name": "Low Design Office",
  "alternateName": ["LowDO", "Low Design Office (LowDO)"],
  "legalName": "Low Design Office",
  "description": siteDescription | striptags,
  "slogan": "Realizing more with less",
  "url": siteUrl,
  "logo": siteUrl + "/" + settings.metadata.site_icon_png,
  "image": (settings.metadata.site_og_image | r2url(siteUrl)) if settings.metadata.site_og_image else null,
  "email": settings.metadata.site_email,
  "telephone": settings.metadata.site_phone,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": addr.street,
    "addressLocality": addr.city,
    "addressRegion": addr.region,
    "postalCode": addr.postal,
    "addressCountry": addr.country
  },
  "location": [
    { "@type": "Place", "name": "Austin, Texas, USA" },
    { "@type": "Place", "name": "Tema, Ghana" }
  ],
  "areaServed": ["Texas", "United States", "Ghana"],
  "knowsAbout": ["Architecture", "Design-build", "Residential architecture", "Sustainable design", "Low-carbon construction", "Bamboo construction"],
  "founder": founders,
  "employee": staff,
  "sameAs": settings.metadata.site_profiles
} %}

{# Home page: Organization + WebSite schema #}
{% if page.url == "/" %}
  <script type="application/ld+json" data-helmet>{{ organizationSchema | dump | safe }}</script>

  {% set webSiteSchema = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": siteName,
    "alternateName": "Low Design Office",
    "url": siteUrl,
    "publisher": { "@id": siteUrl + "/#organization" }
  } %}
  <script type="application/ld+json" data-helmet>{{ webSiteSchema | dump | safe }}</script>

{# Project detail pages: CreativeWork + BreadcrumbList schema.
   Keyed on entryType (always set for entries) rather than `section`: the project layout is
   assigned by eleventyComputed, so its front matter `section: project` never reaches the page.
   Every value below is something the page already shows. jsonLdClean drops empty fields. #}
{% elif entryType == "project" or section == "project" %}
  {% set pageUrl = siteUrl + page.url %}
  {% set orgRef = { "@id": siteUrl + "/#organization" } %}
  {% set imageCaption = title + (", " + location if location else "") + " — Low Design Office" %}

  {# Header image first, then gallery photos (capped to keep the page light) #}
  {% set projectImages = [] %}
  {% if headerImage and headerImage.src %}
    {% set projectImages = (projectImages.push(headerImage), projectImages) %}
  {% endif %}
  {% for image in images %}
    {% if image.src and projectImages.length < 12 %}
      {% set projectImages = (projectImages.push(image), projectImages) %}
    {% endif %}
  {% endfor %}
  {% set imageObjects = [] %}
  {% for image in projectImages %}
    {% set imageObjects = (imageObjects.push({
      "@type": "ImageObject",
      "contentUrl": image | r2url(siteUrl),
      "caption": imageCaption,
      "creditText": "Low Design Office",
      "creator": orgRef
    }), imageObjects) %}
  {% endfor %}

  {# Trade collaborators, each with the role shown in the Trade / Collaborator table #}
  {% set contributors = [] %}
  {% for c in collaborators %}
    {% if c.name %}
      {% set contributors = (contributors.push({
        "@type": "Role",
        "roleName": c.role,
        "contributor": { "@type": "Organization", "name": c.name }
      }), contributors) %}
    {% endif %}
  {% endfor %}

  {# Awards & Recognition rows: awards become `award`, press and other items become `subjectOf` #}
  {% set awardNames = [] %}
  {% set coverage = [] %}
  {% for item in collections.entriesByProject[page.fileSlug] %}
    {% set itemYear = item.data.date | formatDate("YYYY") %}
    {% if item.data.entryType == "award" %}
      {% set awardNames = (awardNames.push(item.data.title + " (" + itemYear + ")"), awardNames) %}
    {% else %}
      {% set coverage = (coverage.push({
        "@type": "CreativeWork",
        "name": item.data.title,
        "url": item.data.link,
        "datePublished": itemYear
      }), coverage) %}
    {% endif %}
  {% endfor %}

  {% set creativeWorkSchema = {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "@id": pageUrl + "#project",
    "name": title,
    "headline": description | striptags if description else null,
    "description": content | striptags(false) | trim if content else null,
    "url": pageUrl,
    "mainEntityOfPage": pageUrl,
    "dateCreated": year | string if year else null,
    "creativeWorkStatus": status,
    "keywords": categories | join(", ") if categories else null,
    "locationCreated": { "@type": "Place", "name": location } if location else null,
    "creator": orgRef,
    "contributor": contributors,
    "award": awardNames,
    "subjectOf": coverage,
    "image": imageObjects,
    "isPartOf": { "@type": "WebSite", "name": siteName, "url": siteUrl }
  } %}
  <script type="application/ld+json" data-helmet>{{ creativeWorkSchema | jsonLdClean | dump | safe }}</script>

  {% set breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl + "/" },
      { "@type": "ListItem", "position": 2, "name": "Index", "item": siteUrl + "/all/" },
      { "@type": "ListItem", "position": 3, "name": title, "item": pageUrl }
    ]
  } %}
  <script type="application/ld+json" data-helmet>{{ breadcrumbSchema | dump | safe }}</script>

{# Projects listing page: CollectionPage schema #}
{% elif page.url == "/projects/" %}
  {% set collectionSchema = {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Projects",
    "description": "Architecture and design projects by " + siteName,
    "url": siteUrl + page.url,
    "isPartOf": {
      "@type": "WebSite",
      "name": siteName,
      "url": siteUrl
    }
  } %}
  <script type="application/ld+json" data-helmet>{{ collectionSchema | dump | safe }}</script>

{# About page: AboutPage schema #}
{% elif page.url == "/about/" %}
  {% set aboutSchema = {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "name": "About " + siteName,
    "description": siteDescription | striptags,
    "url": siteUrl + page.url,
    "mainEntity": organizationSchema
  } %}
  <script type="application/ld+json" data-helmet>{{ aboutSchema | dump | safe }}</script>

{% endif %}
