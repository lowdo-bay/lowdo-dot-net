{# JSON-LD Structured Data for SEO #}
{# Appended to <head> during build via Helmet plugin #}

{% set siteUrl = settings.metadata.site_url %}
{% set siteName = settings.metadata.site_title %}
{% set siteDescription = settings.metadata.seo.site_description or settings.metadata.site_description %}

{# Organization entity — used on the home page and as the About page's mainEntity.
   Contact details, profiles and founders live in settings.yaml. #}
{% set addr = settings.metadata.site_address %}
{% set founders = [] %}
{% for f in settings.metadata.site_founders %}
  {% set founders = (founders.push({
    "@type": "Person",
    "name": f.name,
    "jobTitle": f.title,
    "worksFor": { "@type": "Organization", "name": "Low Design Office" },
    "sameAs": f.profiles
  }), founders) %}
{% endfor %}
{% set organizationSchema = {
  "@context": "https://schema.org",
  "@type": ["Organization", "ProfessionalService"],
  "@id": siteUrl + "/#organization",
  "name": "Low Design Office",
  "alternateName": ["LowDO", "Low Design Office (LowDO)"],
  "legalName": "Low Design Office",
  "description": siteDescription | striptags,
  "slogan": "Realizing more with less",
  "url": siteUrl,
  "logo": siteUrl + "/" + settings.metadata.site_icon_png,
  "image": (settings.metadata.site_og_image | r2url(siteUrl)) if settings.metadata.site_og_image else null,
  "email": settings.metadata.site_email,
  "telephone": settings.metadata.site_phone,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": addr.street,
    "addressLocality": addr.city,
    "addressRegion": addr.region,
    "postalCode": addr.postal,
    "addressCountry": addr.country
  },
  "location": [
    { "@type": "Place", "name": "Austin, Texas, USA" },
    { "@type": "Place", "name": "Tema, Ghana" }
  ],
  "areaServed": ["Texas", "United States", "Ghana"],
  "knowsAbout": ["Architecture", "Design-build", "Residential architecture", "Sustainable design", "Low-carbon construction", "Bamboo construction"],
  "founder": founders,
  "sameAs": settings.metadata.site_profiles
} %}

{# Home page: Organization + WebSite schema #}
{% if page.url == "/" %}
  <script type="application/ld+json" data-helmet>{{ organizationSchema | dump | safe }}</script>

  {% set webSiteSchema = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": siteName,
    "alternateName": "Low Design Office",
    "url": siteUrl,
    "publisher": { "@id": siteUrl + "/#organization" }
  } %}
  <script type="application/ld+json" data-helmet>{{ webSiteSchema | dump | safe }}</script>

{# Project detail pages: CreativeWork schema #}
{% elif section == "project" %}
  {% set imageUrl = (headerImage | r2url(siteUrl)) if headerImage and headerImage.src else null %}
  {% set creativeWorkSchema = {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "name": title,
    "description": (description | striptags) if description else null,
    "datePublished": year | string if year else null,
    "locationCreated": {
      "@type": "Place",
      "name": location
    } if location else null,
    "image": {
      "@type": "ImageObject",
      "url": imageUrl,
      "caption": (title + (", " + location if location else "") + " — Low Design Office"),
      "author": {
        "@type": "Organization",
        "name": "Low Design Office",
        "url": siteUrl
      }
    } if imageUrl else null,
    "creator": {
      "@type": "Organization",
      "name": siteName,
      "url": siteUrl
    },
    "url": siteUrl + page.url
  } %}
  <script type="application/ld+json" data-helmet>{{ creativeWorkSchema | dump | safe }}</script>

{# Projects listing page: CollectionPage schema #}
{% elif page.url == "/projects/" %}
  {% set collectionSchema = {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Projects",
    "description": "Architecture and design projects by " + siteName,
    "url": siteUrl + page.url,
    "isPartOf": {
      "@type": "WebSite",
      "name": siteName,
      "url": siteUrl
    }
  } %}
  <script type="application/ld+json" data-helmet>{{ collectionSchema | dump | safe }}</script>

{# About page: AboutPage schema #}
{% elif page.url == "/about/" %}
  {% set aboutSchema = {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "name": "About " + siteName,
    "description": siteDescription | striptags,
    "url": siteUrl + page.url,
    "mainEntity": organizationSchema
  } %}
  <script type="application/ld+json" data-helmet>{{ aboutSchema | dump | safe }}</script>

{% endif %}
