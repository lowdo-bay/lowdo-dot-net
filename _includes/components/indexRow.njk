{% if entry.data.entryType == 'project' %}
  <a href="{{ entry.url | url }}" class="index-row-link">
{% elif entry.data.link %}
  <a href="{{ entry.data.link }}" class="index-row-link" target="_blank" rel="noopener">
{% elif entry.data.entryType == 'staff' %}
  <div class="index-row-staff-wrapper" role="button" tabindex="0" aria-expanded="false">
{% endif %}

<div class="index-row grid grid--index" data-entry-type="{{ entry.data.entryType }}" data-categories="{% if entry.data.categories and entry.data.categories.length %}{{ entry.data.categories | join(',') | lower }}{% endif %}">

  {# Column 1: Thumbnail Image #}
  <div class="index-col index-col--image">
    {% if entry.data.thumbnail and entry.data.thumbnail.src %}
      <img src="/{{ entry.data.thumbnail.src }}" alt="{{ entry.data.thumbnail.alt or entry.data.title }}" loading="lazy" class="index-row__thumbnail">
    {% endif %}
  </div>

  {# Column 2: Item (Title + Subtitle) #}
  <div class="index-col index-col--item">
    <span class="index-row__title">{{ entry.data.title }}</span>
    {% if entry.data.entryType == 'project' %}
      {% if entry.data.description %}<span class="index-row__subtitle">{{ entry.data.description }}</span>{% endif %}
    {% else %}
      {% if entry.data.subtitle %}<span class="index-row__subtitle">{{ entry.data.subtitle }}</span>{% endif %}
    {% endif %}
  </div>

  {# Column 3: Details/Description #}
  <div class="index-col index-col--details">
    {% if entry.data.entryType or entry.data.categories %}
      <span class="index-row__categories">{% if entry.data.entryType %}{{ entry.data.entryType | upper }}{% endif %}{% if entry.data.entryType and entry.data.categories and entry.data.categories.length %}, {% endif %}{% if entry.data.categories and entry.data.categories.length %}{{ entry.data.categories | join(', ') | upper }}{% endif %}</span>
    {% endif %}
    {% if entry.data.collaborators and entry.data.collaborators.length %}
      <span class="index-row__collaborators">
        <em>IN COLLABORATION WITH:</em><br>
        {% for collab in entry.data.collaborators %}
          {{ collab.name | upper }}{% if not loop.last %}, {% endif %}
        {% endfor %}
      </span>
    {% endif %}
    {% if entry.data.entryType != 'project' and entry.data.description %}
      <span class="index-row__description">{{ entry.data.description }}</span>
    {% endif %}
  </div>

  {# Column 4: Date #}
  <div class="index-col index-col--date">
    {% if entry.data.date %}
      <span class="index-row__date-year">{{ entry.data.date | formatDate("YYYY") }}</span>
      <span class="index-row__date-mmdd">{{ entry.data.date | formatDate("MMDD") }}</span>
    {% elif entry.data.year %}
      <span class="index-row__date-year">{{ entry.data.year }}</span>
    {% endif %}
  </div>

  {# Mobile meta row: description (projects) or description (non-projects) #}
  <div class="index-row__meta">
    {% if entry.data.entryType == 'project' and entry.data.description %}
      <span class="index-row__meta-text">{{ entry.data.description }}</span>
    {% elif entry.data.entryType != 'project' and entry.data.description %}
      <span class="index-row__meta-text">{{ entry.data.description }}</span>
    {% endif %}
  </div>

</div>

{% if entry.data.entryType == 'staff' %}
<div class="index-row__body" aria-hidden="true">
  <div class="index-row__body-inner">
    {{ entry.templateContent | safe }}
  </div>
</div>
</div>{# close .index-row-staff-wrapper #}
{% elif entry.data.entryType == 'project' or entry.data.link %}
  </a>
{% endif %}
