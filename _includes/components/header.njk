<header class="p--content">

	<div class="grid grid--header">

		{# Column 1: Site Title + Subtitles (mobile stacked) #}
		<div class="grid__item header-title">
			<a href="{{ '/' | url }}" class="link-nostyle">
				{# SEO: home page header title should be inside a h1 tag #}
				{% if page.url == "/" %}
					<h1>{{ settings.metadata.site_title }}</h1>
				{% else %}
					<span>{{ settings.metadata.site_title }}</span>
				{% endif %}
			</a>
			{# Subtitles shown here on mobile, hidden on desktop #}
			{% if settings.metadata.site_subtitle_1 %}
				<span class="header-subtitle header-subtitle--mobile">{{ settings.metadata.site_subtitle_1 }}</span>
			{% endif %}
			{% if settings.metadata.site_subtitle_2 %}
				<span class="header-subtitle header-subtitle--mobile">{{ settings.metadata.site_subtitle_2 }}</span>
			{% endif %}
		</div>

		{# Column 2: Subtitle 1 (desktop only) #}
		{% if settings.metadata.site_subtitle_1 %}
			<span class="grid__item header-subtitle--desktop">{{ settings.metadata.site_subtitle_1 }}</span>
		{% endif %}

		{# Column 3: Subtitle 2 (desktop only) #}
		{% if settings.metadata.site_subtitle_2 %}
			<span class="grid__item header-subtitle--desktop">{{ settings.metadata.site_subtitle_2 }}</span>
		{% endif %}

		{# Column 4: Menu (right-aligned) #}
		<div class="grid__item grid__item--end grid__item--top">
			<div class="header-menu">
				<button class="header-menu__button" aria-expanded="false" aria-label="Menu">
					<svg width="20" height="14" viewBox="0 0 20 14" fill="none" aria-hidden="true">
						<line x1="0" y1="1" x2="20" y2="1" stroke="currentColor" stroke-width="2"/>
						<line x1="0" y1="7" x2="20" y2="7" stroke="currentColor" stroke-width="2"/>
						<line x1="0" y1="13" x2="20" y2="13" stroke="currentColor" stroke-width="2"/>
					</svg>
				</button>
				<nav class="header-menu__dropdown" aria-label="Main navigation">
					<a href="{{ '/all/' | url }}" class="header-menu__item">Index</a>
					<a href="{{ '/projects/' | url }}" class="header-menu__item">Projects</a>
					<a href="{{ '/about/' | url }}" class="header-menu__item">About</a>
					{% if settings.theme.theme_features.enable_dark_mode %}
						<div class="header-menu__item dark-toggle">
							<label for="toggle" class="toggle__label">
								<svg width="14" height="14" viewBox="0 0 16 16">
									<circle pid="0" cx="8" cy="8" r="7.5" fill="var(--color-text)" stroke="var(--color-text)"></circle>
									<path pid="1" d="M1 8a7 7 0 007 7V1a7 7 0 00-7 7z" fill="var(--color-background)"></path>
								</svg>
								<span class="toggle__text">Dark Mode</span>
								<input type="checkbox" name="toggle" id="toggle" class="toggle__checkbox">
							</label>
						</div>
					{% endif %}
				</nav>
			</div>
		</div>

	</div>

</header>
