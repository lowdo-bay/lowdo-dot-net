---
layout: layouts/base.njk
permalink: "project/{{ title | slug }}/index.html"
section: project
---

{# Template-scoped styles — no changes to base.css #}
<style>
  /* Right column: 2-col sub-grid (maps to page cols 3 & 4).
     Scoped to article to override base.css display:flex on .project-metadata */
  article .project-metadata {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-content: start;
    margin-bottom: 0;
    margin-right: calc(1 * var(--space-2));
  }

  /* Right grid item: size to content (metadata), sets the row height */
  .project-header .grid__item--span-2-right {
    margin-bottom: 0;
    /* Size to content, don't stretch */
    align-self: auto;
    /* Escape to right screen edge */
    margin-right: calc(-1 * var(--content-margin));
  }

  /* Metadata grid inside right column: stack top and bottom sections vertically */
  .project-header .project-metadata {
    display: flex;
    flex-direction: column;
  }

  /* Top section: title, tagline, tags — aligned to top */
  .project-meta-top {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-auto-rows: max-content;
    align-content: start;
  }

  /* Bottom section: metadata rows — aligned to top */
  .project-meta-bottom {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-auto-rows: max-content;
    align-content: start;
    position: relative;
  }

  /* Mobile: dashed line at the top of project-meta-bottom */
  @media (max-width: 839px) {
    .project-meta-bottom::before {
      content: '';
      position: absolute;
      top: 0;
      left: calc(-1 * var(--content-margin) - var(--space-2));
      width: calc(100vw + var(--content-margin));
      border-top: var(--grid-line-thickness) var(--grid-line-horizontal-minor-style) var(--grid-line-color);
    }
  }

  /* Metadata row wrapper: use display: contents to not affect grid */
  .project-meta-row {
    display: contents;
  }

  /* Title: spans both sub-columns, all caps, bold */
  .project-meta-title {
    grid-column: 1 / span 2;
    padding: 0 var(--space-2) var(--space-2) var(--space-2);
    font-size: var(--font-size-base);
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Tagline: sub-col 1 (page col 3) */
  .project-meta-tagline {
    padding: var(--space-2);
    font-size: var(--font-size-small);
  }

  /* Tags: sub-col 2 (page col 4) */
  .project-meta-tags {
    padding: var(--space-2);
    font-size: var(--font-size-small);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Metadata label: sub-col 1, not bold */
  .project-meta-label {
    padding: var(--space-2);
    font-size: var(--font-size-small);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: normal;
    position: relative;
  }

  /* Dashed line starts at center column line and extends to right screen edge.
     left: calc(-1 * var(--space-2)) backs up to the grid item's padding edge (= center column line) */
  .project-meta-label::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: calc(-1 * var(--space-2));
    width: 200vw;
    border-bottom: var(--grid-line-thickness) var(--grid-line-horizontal-minor-style) var(--grid-line-color);
  }

  /* Mobile: extend dashed line to left screen edge */
  @media (max-width: 839px) {
    .project-meta-label::after {
      left: calc(-1 * var(--content-margin) - var(--space-2));
      width: calc(100vw + var(--content-margin));
    }
  }

  /* Metadata value: sub-col 2 */
  .project-meta-value {
    padding: var(--space-2);
    font-size: var(--font-size-small);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .project-collab-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    position: relative;
  }
  .project-collab-cell {
    padding: var(--space-2);
    font-size: var(--font-size-small);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: none;
    position: relative;
  }
  /* Vertical divider between columns: only on data cells (not header), stops at header line */
  .project-collab-cell:not(.project-collab-cell--head):nth-child(odd)::before {
    content: '';
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    border-right: var(--grid-line-thickness) var(--grid-line-vertical-style) var(--grid-line-color);
  }
  @media (min-width: 840px) {
    .project-collab-cell:not(.project-collab-cell--head):nth-child(odd)::before {
      display: none;
    }
  }
  .project-collab-cell:not(.project-collab-cell--head)::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: calc(-1 * var(--space-2));
    right: calc(-1 * var(--space-2));
    border-bottom: var(--grid-line-thickness) var(--grid-line-horizontal-minor-style) var(--grid-line-color);
  }
  .project-collab-cell--head {
    font-weight: bold;
    border-bottom: none !important;
    position: relative;
  }
  .project-collab-cell--head:first-child::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 200vw;
    border-bottom: var(--grid-line-thickness) var(--grid-line-horizontal-major-style) var(--grid-line-color);
  }

  /* Portrait header: hide dashed line under Trade header, add line under Description */
  @media (min-width: 840px) {
    section.is-portrait-header .project-collab-cell--head:first-child::after {
      display: none;
    }

    section.is-portrait-header .project-desc-header {
      border-bottom: none;
      padding-bottom: var(--space-2);
      position: relative;
    }

    section.is-portrait-header .project-desc-header::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 50%;
      width: 100vw;
      transform: translateX(-50%);
      border-bottom: var(--grid-line-thickness) var(--grid-line-horizontal-major-style) var(--grid-line-color);
    }
  }

  .project-collab-cell--head:first-child::before {
    content: '';
    position: absolute;
    bottom: 0;
    left: calc(-1 * var(--space-2));
    right: calc(-100% - var(--space-2));
    width: auto;
    transform: none;
    border-bottom: var(--grid-line-thickness) var(--grid-line-horizontal-major-style) var(--grid-line-color);
    border-bottom-width: calc(2 * var(--grid-line-thickness));
  }

  .project-collab-grid:nth-of-type(2) .project-collab-cell--head:first-child::after {
    left: calc(-1 * var(--space-2));
    right: calc(-100% - var(--space-2));
    width: auto;
    transform: none;
    border-bottom-width: calc(2 * var(--grid-line-thickness));
  }

  .project-section-header {
    position: relative;
    padding-bottom: 0;
  }
  .project-section-header::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    border-bottom: var(--grid-line-thickness) var(--grid-line-horizontal-major-style) var(--grid-line-color);
  }

  /* Full-width sections: Photos, Drawings, Related Projects */
  .project-photos-section .project-section-header::after,
  .project-drawings-section .project-section-header::after,
  .project-related-section .project-section-header::after {
    left: 50%;
    transform: translateX(-50%);
  }

  /* Toolkit section in right column: extend to left screen edge */
  .project-toolkit-section .project-section-header::after {
    left: calc(-50vw - var(--content-margin));
    width: calc(100vw + var(--content-margin));
    transform: none;
  }
  .project-section-header-inner {
    display: grid;
    grid-template-columns: 1fr;
  }
  @media (min-width: 840px) {
    .project-section-header-inner {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .project-section-header-cell {
    padding: var(--space-2);
    font-size: var(--font-size-small);
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .project-download-row {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    position: relative;
  }
  .project-download-cell--title {
    flex: 1;
  }
  /* Separator line under each download row */
  .project-download-row::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: calc(-1 * var(--space-2));
    right: calc(-1 * var(--space-2));
    border-bottom: var(--grid-line-thickness) var(--grid-line-horizontal-minor-style) var(--grid-line-color);
  }
  /* Remove line from first item */
  .project-download-row:first-child::after {
    display: none;
  }
  /* Gate drawer separator below it */
  .download-gate::after {
    content: '';
    display: block;
    margin-left: calc(-1 * var(--space-2));
    margin-right: calc(-1 * var(--space-2));
    border-bottom: var(--grid-line-thickness) var(--grid-line-horizontal-minor-style) var(--grid-line-color);
  }
  .project-download-cell {
    padding: var(--space-2);
    font-size: var(--font-size-small);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .project-download-cell--format {
    opacity: 0.6;
  }
  .project-download-cell--action {
    text-align: right;
    white-space: nowrap;
  }
  .project-download-cell--action button {
    appearance: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    font-family: inherit;
    text-transform: uppercase;
    color: inherit;
    transition: color var(--transition-time) ease;
    position: relative;
    z-index: 1;
  }
  .project-download-cell--action button::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--color-accent-1);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--transition-time) ease;
    z-index: -1;
  }
  .project-download-row.gate-open .project-download-cell--action button {
    color: #999999;
  }
  .project-download-row.gate-ready .project-download-cell--action button::before {
    transform: scaleX(1);
  }
  .project-download-row.gate-ready .project-download-cell--action button {
    color: #ffffff;
  }

  /* Download gate drawer */
  .download-gate {
    overflow: hidden;
    max-height: 0;
    transition: max-height 300ms ease;
    background-color: var(--color-accent-5);
    margin-left: calc(-1 * var(--space-2));
    margin-right: calc(-1 * var(--space-2));
  }
  .download-gate.is-open {
    max-height: 200px;
  }
  .download-gate-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4) var(--space-4) calc(var(--space-2) + 1em + var(--space-2));
  }
  .download-gate__email {
    background: transparent;
    border: none;
    border-bottom: var(--grid-line-thickness) solid var(--grid-line-color);
    color: inherit;
    font: inherit;
    font-size: var(--font-size-small);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    width: 100%;
    padding: var(--space-1) 0;
    outline: none;
  }
  .download-gate__email::placeholder {
    opacity: 0.4;
  }
  .download-gate__checkbox-row {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--font-size-small);
    opacity: 0.8;
  }
  .download-gate__checkbox-row input[type="checkbox"] {
    appearance: none;
    -webkit-appearance: none;
    margin-top: 2px;
    flex-shrink: 0;
    width: 0.85em;
    height: 0.85em;
    border: var(--grid-line-thickness) solid var(--grid-line-color);
    border-radius: 0;
    background: transparent;
    cursor: pointer;
    position: relative;
  }
  .download-gate__checkbox-row input[type="checkbox"]:checked {
    background-color: var(--color-accent-1);
  }
  .download-gate__checkbox-row input[type="checkbox"]:checked::after {
    content: '';
    display: block;
    position: absolute;
    left: 15%;
    top: 5%;
    width: 40%;
    height: 65%;
    border-right: 2px solid var(--color-background);
    border-bottom: 2px solid var(--color-background);
    transform: rotate(40deg);
  }
  .project-drawings-section {
    margin-top: var(--space-6);
  }

  /* Light blue background: only on the grid area (from solid line to bottom dashed line) */
  /* Drawings grid: 2 columns on mobile, 4 on desktop */
  .project-drawings-grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin-left: calc(-50vw + 50%);
    margin-right: calc(-50vw + 50%);
    padding-left: calc(50vw - 50%);
    padding-right: calc(50vw - 50%);
    background-color: var(--project-header-bg);
  }

  @media (min-width: 840px) {
    .project-drawings-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Each drawing cell: padding inside the grid column */
  .project-drawing-cell {
    padding: var(--space-2);
    position: relative;
  }
  .project-drawing-cell:nth-child(odd) {
    border-right: var(--grid-line-thickness) var(--grid-line-vertical-style) var(--grid-line-color);
  }
  @media (min-width: 840px) {
    .project-drawing-cell:nth-child(odd) {
      border-right: none;
    }
  }

  /* Dashed line under each row: every 2nd cell on mobile */
  .project-drawing-cell:nth-child(2n)::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 200vw;
    border-bottom: var(--grid-line-thickness) var(--grid-line-horizontal-minor-style) var(--grid-line-color);
  }

  /* Dashed line under each row: every 4th cell on desktop */
  @media (min-width: 840px) {
    .project-drawing-cell:nth-child(2n)::after {
      display: none;
    }
    .project-drawing-cell:nth-child(4n)::after {
      display: block;
    }
  }

  /* Full width, native aspect ratio, aligned top */
  .project-drawing-cell img {
    width: 100%;
    height: auto;
    display: block;
    vertical-align: top;
  }

  .project-desc-header {
    padding: var(--space-2);
    font-size: var(--font-size-small);
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: none;
    position: relative;
  }

  .project-desc-body {
    padding: var(--space-2);
  }
  .project-desc-body p {
    margin-bottom: var(--space-3);
  }

  /* Header: remove bottom padding, create stacking context to isolate grid lines above image */
  .project-header {
    padding-bottom: 0;
    padding-top: var(--space-3);
    z-index: 1;
  }

  /* Header grid: metadata height sets row height, image crops to match */
  .project-header .grid {
    align-items: start;
  }

  /* Image: flush to grid lines, stretches to metadata height */
  .project-header .grid__item--span-2-left {
    padding: 0;
    /* Stretch to match metadata height — does not contribute to row height */
    align-self: stretch;
    /* Escape project-header left padding to reach 1st column line (padding: 0 already zeroes grid item padding) */
    margin-left: calc(-1 * var(--content-margin));
    /* Escape actual top padding (--space-3) to reach blue background top border */
    margin-top: calc(-1 * var(--space-3));
    /* No escape needed — project-header has padding-bottom: 0 */
    margin-bottom: 0;
    /* Positioning context for absolutely placed image */
    position: relative;
    overflow: hidden;
  }

  .project-header .header-image {
    /* Absolutely fill the container — zero layout contribution to row height */
    position: absolute;
    inset: 0;
    z-index: 1;
    /* Override base.css height: 30vh — height must be driven by containing block, not viewport */
    height: 100%;
    display: flex;
    overflow: hidden;
  }

  .project-header .header-image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  /* ---- Portrait header: image is absolutely positioned (out of flow),
     so header height = metadata column height only (DESKTOP ONLY) ---- */

  @media (min-width: 840px) {
    /* Header must be overflow:visible so image can bleed downward */
    .project-header.is-portrait-header {
      overflow: visible;
      margin-bottom: 0;
      position: relative;
    }

    /* Image container: absolutely positioned, left viewport edge to 2-col midpoint,
       height driven by aspect-ratio so image shows in full */
    .project-header.is-portrait-header .grid__item--span-2-left {
      position: absolute;
      left: 0;
      top: 0;
      width: calc(var(--content-width) / 2);
      height: calc(var(--content-width) / 2 * var(--portrait-image-ratio));
      aspect-ratio: 1 / var(--portrait-image-ratio);
      margin: 0;
      overflow: visible;
      z-index: 2;
      align-self: auto;
    }

    /* Image fills the absolutely-positioned container */
    .project-header.is-portrait-header .header-image {
      position: absolute;
      inset: 0;
      height: 100%;
    }

    .project-header.is-portrait-header .header-image img {
      object-fit: cover;
      height: 100%;
    }

    /* Section after portrait header: sits flush below metadata (no extra top padding).
       Left column padded down by full image height to clear the bleed. */
    section.is-portrait-header {
      padding-top: 0;
    }

    /* Left column: pushed down by JS-measured image height minus header height */
    section.is-portrait-header .grid__item--span-2-left {
      padding-top: var(--portrait-image-bleed, 0px);
    }
  }

  /* Add vertical spacing above photos section */
  .project-photos-section {
    margin-top: var(--space-6);
  }

  /* Photos grid: 2 columns on mobile, 4 on desktop */
  .project-photos-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  @media (min-width: 840px) {
    .project-photos-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Each photo cell: padding inside the grid column */
  .project-photo-cell {
    padding: var(--space-2);
    position: relative;
  }
  .project-photo-cell:nth-child(odd) {
    border-right: var(--grid-line-thickness) var(--grid-line-vertical-style) var(--grid-line-color);
  }
  @media (min-width: 840px) {
    .project-photo-cell:nth-child(odd) {
      border-right: none;
    }
    .project-photo-cell:not(:nth-child(4n)) {
      border-right: none;
    }
  }

  /* Dashed line under each row: every 2nd cell on mobile */
  .project-photo-cell:nth-child(2n)::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 200vw;
    border-bottom: var(--grid-line-thickness) var(--grid-line-horizontal-minor-style) var(--grid-line-color);
  }

  /* Dashed line under each row: every 4th cell on desktop */
  @media (min-width: 840px) {
    .project-photo-cell:nth-child(2n)::after {
      display: none;
    }
    .project-photo-cell:nth-child(4n)::after {
      display: block;
    }
  }

  /* Square crop */
  .project-photo-cell .photo-thumb {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .project-photo-cell .photo-thumb picture,
  .project-photo-cell .photo-thumb img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  /* Related projects grid: 2 columns on mobile, 4 on desktop */
  .project-related-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  @media (min-width: 840px) {
    .project-related-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .project-related-cell {
    padding: var(--space-2);
    position: relative;
  }
  .project-related-cell:nth-child(odd) {
    border-right: var(--grid-line-thickness) var(--grid-line-vertical-style) var(--grid-line-color);
  }
  @media (min-width: 840px) {
    .project-related-cell:nth-child(odd) {
      border-right: none;
    }
  }

  /* Dashed row separator — mirrors photo grid pattern */
  .project-related-cell:nth-child(2n)::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 200vw;
    border-bottom: var(--grid-line-thickness) var(--grid-line-horizontal-minor-style) var(--grid-line-color);
  }

  @media (min-width: 840px) {
    .project-related-cell:nth-child(2n)::after { display: none; }
    .project-related-cell:nth-child(4n)::after { display: block; }
  }

  /* Header image: 3:2 landscape crop */
  .project-related-cell .related-thumb {
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    margin-bottom: var(--space-2);
  }

  .project-related-cell .related-thumb picture,
  .project-related-cell .related-thumb img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  .project-related-title {
    font-size: var(--font-size-small);
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-1);
  }

  .project-related-desc {
    font-size: var(--font-size-small);
    opacity: 0.7;
  }

  /* Tooltip: follows mouse, hidden by default */
  .photo-tooltip {
    position: fixed;
    pointer-events: none;
    z-index: 1000;
    background: white;
    color: var(--color-accent);
    padding: var(--space-2) var(--space-3);
    font-size: var(--font-size-small);
    white-space: nowrap;
    display: none;
    box-shadow: 0 1px 4px rgba(0,0,0,0.12);
  }

  .photo-tooltip__caption {
    display: block;
    font-weight: bold;
  }

  .photo-tooltip__hint {
    display: block;
    font-weight: normal;
  }

  /* Drawing thumb and tooltip */
  .project-drawing-cell .drawing-thumb {
    position: relative;
    display: block;
    cursor: pointer;
  }

  /* Tooltip: follows mouse, hidden by default */
  .drawing-tooltip {
    position: fixed;
    pointer-events: none;
    z-index: 1000;
    background: white;
    color: var(--color-accent);
    padding: var(--space-2) var(--space-3);
    font-size: var(--font-size-small);
    white-space: nowrap;
    display: none;
    box-shadow: 0 1px 4px rgba(0,0,0,0.12);
  }

  .drawing-tooltip__caption {
    display: block;
    font-weight: bold;
  }

  .drawing-tooltip__hint {
    display: block;
    font-weight: normal;
  }

  /* Add vertical spacing above design toolkit and related projects sections */
  .project-toolkit-section,
  .project-related-section {
    margin-top: var(--space-6);
  }

  /* Toolkit section should not have its own ::after line (uses child header line) */
  .project-toolkit-section::after {
    display: none !important;
  }

  /* ---- Modal image viewer ---- */
  .photo-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 10000;
    align-items: center;
    justify-content: center;
  }
  .photo-modal.is-open {
    display: flex;
  }
  .photo-modal__scrim {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.72);
    cursor: pointer;
    animation: modal-scrim-in var(--transition-time) ease forwards;
  }
  @keyframes modal-scrim-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  .photo-modal.is-closing .photo-modal__scrim {
    animation: modal-scrim-in var(--transition-time) ease reverse forwards;
  }
  .photo-modal__scrim {
    cursor: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="%23E1E1E1" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter"><line x1="4" y1="4" x2="20" y2="20"/><line x1="20" y1="4" x2="4" y2="20"/></svg>') 12 12, auto;
  }
  .photo-modal__card {
    position: relative;
    background: var(--color-background);
    max-width: 90vw;
  }
  .photo-modal__image-wrap {
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    outline: var(--grid-line-thickness) solid var(--grid-line-color);
    animation: modal-card-in var(--transition-time) ease forwards;
  }
  @keyframes modal-card-in {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .photo-modal.is-closing .photo-modal__card {
    animation: modal-card-in var(--transition-time) ease reverse forwards;
  }
  .photo-modal__zone-prev,
  .photo-modal__zone-next {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    z-index: 1;
  }
  .photo-modal__zone-prev {
    left: 0;
    cursor: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="%23E1E1E1" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter"><line x1="6" y1="12" x2="18" y2="12"/><polyline points="10 6 4 12 10 18"/></svg>') 12 12, auto;
  }
  .photo-modal__zone-next {
    right: 0;
    cursor: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="%23E1E1E1" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter"><line x1="6" y1="12" x2="18" y2="12"/><polyline points="14 6 20 12 14 18"/></svg>') 12 12, auto;
  }
  .photo-modal__zone-prev.is-disabled,
  .photo-modal__zone-next.is-disabled {
    cursor: default;
    pointer-events: none;
  }
  .photo-modal__close {
    flex-shrink: 0;
    width: 2.5rem;
    background: var(--color-background);
    border: none;
    border-left: var(--grid-line-thickness) solid var(--grid-line-color);
    cursor: pointer;
    font-family: inherit;
    font-size: 1.2rem;
    color: var(--color-text);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background var(--transition-time) ease;
    outline: none;
  }
  .photo-modal__close:focus-visible,
  .photo-modal__close:hover {
    background: var(--color-accent-5);
  }
  .photo-modal__caption-row {
    display: flex;
    align-items: stretch;
    border-top: var(--grid-line-thickness) var(--grid-line-horizontal-minor-style) var(--grid-line-color);
    cursor: default;
  }
  .photo-modal__counter {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    padding: 0 var(--space-3);
    font-size: var(--font-size-small);
    color: var(--color-text);
    opacity: 0.5;
    border-left: var(--grid-line-thickness) solid var(--grid-line-color);
    white-space: nowrap;
  }
  .photo-modal__image-wrap {
    position: relative;
    overflow: hidden;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
  }
  .photo-modal__img {
    display: block;
    max-width: 90vw;
    max-height: calc(90vh - 3rem);
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .photo-modal__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }
  .photo-modal__placeholder.is-hidden {
    opacity: 0;
  }
  .photo-modal__placeholder img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: 90vw;
    max-height: calc(90vh - 3rem);
    object-fit: contain;
  }

  /* White background for PNG images with transparent backgrounds */
  .photo-thumb[data-ispng="true"],
  .drawing-thumb[data-ispng="true"] {
    background-color: #ffffff;
  }
  .photo-modal__card.has-png-image {
    background: #ffffff !important;
  }

  .photo-modal__caption {
    flex: 1;
    padding: var(--space-2) var(--space-3);
    font-size: var(--font-size-small);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    min-height: 2rem;
  }
  /* Mobile: tighter sizing */
  @media (max-width: 839px) {
    /* On mobile, reduce header padding to match content padding */
    .project-header {
      padding-top: var(--space-2);
      padding-left: var(--space-2);
      padding-right: var(--space-2);
    }

    /* On mobile, image stacks vertically. Remove absolute positioning
       to let the image display at its natural aspect ratio */
    .project-header .grid__item--span-2-left {
      position: static;
      overflow: visible;
      margin-left: 0;
      margin-top: 0;
      padding: 0;
    }

    .project-header .header-image {
      position: static;
      height: auto;
      display: block;
      overflow: visible;
      position: relative;
      padding-bottom: var(--space-2);
    }

    .project-header .header-image::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: calc(-1 * var(--content-margin) - var(--space-2));
      width: calc(100vw + var(--content-margin));
      border-bottom: var(--grid-line-thickness) var(--grid-line-horizontal-minor-style) var(--grid-line-color);
    }

    .project-header .header-image img {
      height: auto;
    }

    /* On mobile, constrain metadata to same width as image */
    .project-header .grid__item--span-2-right {
      margin-top: var(--space-3);
      margin-right: 0;
      padding-right: var(--space-2);
    }

    /* Suppress duplicate line on the second cell of each row in collaborator/award tables */
    .project-collab-cell:not(.project-collab-cell--head):nth-child(even)::after {
      display: none;
    }

    /* Extend the single line edge-to-edge */
    .project-collab-cell:not(.project-collab-cell--head):nth-child(odd)::after {
      left: 50%;
      transform: translateX(-50%);
      width: 200vw;
    }

    /* Hide thick header line on mobile */
    .project-collab-cell--head:first-child::before {
      display: none;
    }

    /* Hide thick header line on mobile for awards table */
    .project-collab-grid:nth-of-type(2) .project-collab-cell--head:first-child::before {
      display: none;
    }

    /* Convert thick line to normal dashed line on awards table */
    .project-collab-grid:nth-of-type(2) .project-collab-cell--head:first-child::after {
      border-bottom-width: var(--grid-line-thickness) !important;
    }

    /* Keep dashed header line full width on mobile */
    .project-collab-cell--head:first-child::after {
      left: 50%;
      right: auto;
      width: 200vw;
      transform: translateX(-50%);
    }

    /* Keep dashed header line full width on mobile for awards table */
    .project-collab-grid:nth-of-type(2) .project-collab-cell--head:first-child::after {
      left: 50%;
      right: auto;
      width: 200vw;
      transform: translateX(-50%);
    }

    /* Add top margin and full-width line under Description header on mobile */
    .project-desc-header {
      border-bottom: none;
      position: relative;
      margin-top: var(--space-8);
    }

    .project-desc-header::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 200vw;
      border-bottom: var(--grid-line-thickness) var(--grid-line-horizontal-major-style) var(--grid-line-color);
    }

    /* Remove top margin from awards section on mobile */
    .project-collab-grid:nth-of-type(2) {
      margin-top: 0 !important;
    }


    .photo-modal__card {
      max-width: 96vw;
      max-height: 92vh;
    }
    .photo-modal__img {
      max-width: 96vw;
      max-height: calc(92vh - 3rem);
    }
  }
</style>

<article>

  {# =========================================================
     SECTION 1: Project Header — Image left, metadata right
     ========================================================= #}
  <header class="project-header{% if headerImageOrientation === 'portrait' %} is-portrait-header{% endif %}"{% if headerImageOrientation === 'portrait' %} style="--portrait-image-ratio: {{ headerImageRatio }};"{% endif %}>
    <div class="grid grid--intro">

      {# Left: Header Image #}
      {% if headerImage %}
        <div class="grid__item--span-2-left">
          {% set outputFormats = [] %}
          {% for format, i in settings.images %}
            {% if i.enabled === true %}
              {{ '' if outputFormats.push(format) }}
            {% endif %}
          {% endfor %}
          {% set params = {
            "src": headerImage.src,
            "alt": title,
            "classes": "header-image",
            "loadingType": "eager",
            "viewportSizes": "50vw",
            "outputWidths": [
              settings.config.image_width_sm,
              settings.config.image_width_md,
              settings.config.image_width_lg
            ],
            "outputFormats": outputFormats,
            "outputQualityJpeg": settings.images.jpeg.quality,
            "outputQualityWebp": settings.images.webp.quality,
            "outputQualityAvif": settings.images.avif.quality
          } %}
          {% if headerImage.src | endsWith('.gif') %}
            <picture>
              <img src="/{{ headerImage.src }}" alt="{{ title }}" loading="eager" decoding="async" class="header-image">
            </picture>
          {% else %}
            {% generateImage params %}
          {% endif %}
        </div>
      {% endif %}

      {# Right: Title, tagline, categories, metadata — 2-col sub-grid #}
      <div class="grid__item--span-2-right project-metadata">

        {# Top section: Title, tagline, tags #}
        <div class="project-meta-top">
          {# Row 1: Title spanning both sub-columns #}
          <div class="project-meta-title">{{ title }}</div>

          {# Row 2: Tagline (col 3) + Categories (col 4) #}
          <div class="project-meta-tagline">
            {% if description %}{{ description | renderUsingMarkdown | safe }}{% endif %}
          </div>
          <div class="project-meta-tags">
            {% if categories and categories.length %}{{ categories | join(', ') | upper }}{% endif %}
          </div>
        </div>

        {# Bottom section: Location, year, status #}
        <div class="project-meta-bottom">
          {# Rows: Label (col 3) + Value (col 4) #}
          {% if location %}
            <div class="project-meta-row">
              <div class="project-meta-label">Location</div>
              <div class="project-meta-value">{{ location }}</div>
            </div>
          {% endif %}
          {% if year and settings.theme.theme_features.show_project_year %}
            <div class="project-meta-row">
              <div class="project-meta-label">Year</div>
              <div class="project-meta-value">{{ year }}</div>
            </div>
          {% endif %}
          {% if status %}
            <div class="project-meta-row">
              <div class="project-meta-label">Status</div>
              <div class="project-meta-value">{{ status }}</div>
            </div>
          {% endif %}
        </div>

      </div>

    </div>
  </header>

  {# =========================================================
     SECTION 2: Collaborators (left) + Description (right)
     ========================================================= #}
  <section{% if headerImageOrientation === 'portrait' %} class="is-portrait-header" style="--portrait-image-ratio: {{ headerImageRatio }};"{% endif %}>
    <div class="grid grid--intro">

      {# Left: Trade / Collaborator table + Awards & Recognition #}
      <div class="grid__item--span-2-left">
        {% if collaborators and collaborators.length %}
          <div class="project-collab-grid">
            <div class="project-collab-cell project-collab-cell--head">Trade</div>
            <div class="project-collab-cell project-collab-cell--head">Collaborator</div>
            {% for collab in collaborators %}
              <div class="project-collab-cell">{{ collab.role | upper }}</div>
              <div class="project-collab-cell">{{ collab.name | upper }}</div>
            {% endfor %}
          </div>
        {% endif %}

        {# Awards & Recognition section (using collaborators styling) #}
        {% set projectRecognition = collections.entriesByProject[page.fileSlug] %}
        {% if projectRecognition and projectRecognition.length %}
          <div class="project-collab-grid" style="margin-top: var(--space-6); padding-top: var(--space-6)">
            <div class="project-collab-cell project-collab-cell--head">Awards & Recognition</div>
            <div class="project-collab-cell project-collab-cell--head"> </div>
            {% for item in projectRecognition %}
              <div class="project-collab-cell">
                {% if item.data.link %}
                  <a href="{{ item.data.link }}" target="_blank" rel="noopener">{{ item.data.title }}</a>
                {% else %}
                  {{ item.data.title }}
                {% endif %}
              </div>
              <div class="project-collab-cell">{% if item.data.categories and item.data.categories.length %}{{ item.data.categories | join(', ') | upper }} ({{ item.data.date | formatDate("YYYY") }}){% else %}({{ item.data.date | formatDate("YYYY") }}){% endif %}</div>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      {# Right: Description body text #}
      <div class="grid__item--span-2-right">
        <div class="project-desc-header">Description</div>
        <div class="project-desc-body">
          {{ content | safe }}
        </div>
      </div>

    </div>
  </section>

  {# =========================================================
     SECTION 4: Photos
     ========================================================= #}
  {% if images and images.length %}
  <section class="project-photos-section">

    <div class="project-section-header">
      <div class="project-section-header-inner">
        <div class="project-section-header-cell">Photos</div>
      </div>
    </div>

    <div class="project-photos-grid">
      {% for image in images %}

        {% set outputFormats = [] %}
        {% for format, i in settings.images %}
          {% if i.enabled === true %}
            {{ '' if outputFormats.push(format) }}
          {% endif %}
        {% endfor %}

        {% set params = {
          "src": image.src,
          "alt": image.caption or title,
          "loadingType": "lazy",
          "viewportSizes": "(min-width: 1140px) 22vw, (min-width: 540px) 45vw, 85vw",
          "outputWidths": [
            settings.config.image_grid_width_sm,
            settings.config.image_grid_width_md,
            settings.config.image_grid_width_lg
          ],
          "outputFormats": outputFormats,
          "outputQualityJpeg": settings.images.jpeg.quality,
          "outputQualityWebp": settings.images.webp.quality,
          "outputQualityAvif": settings.images.avif.quality
        } %}

        <div class="project-photo-cell">
          <div class="photo-thumb" data-caption="{{ image.caption or '' }}" data-fullsrc="{% if not (image.src | endsWith('.gif')) %}{% getImageSrc { src: image.src, width: settings.config.image_width_md, quality: settings.config.image_quality_mediumsrc } %}{% endif %}" data-ispng="{{ 'true' if image.src | endsWith('.png') else '' }}">
            {% if image.src | endsWith('.gif') %}
              <picture>
                <img src="/{{ image.src }}" alt="{{ image.caption or title }}" loading="lazy" decoding="async" class="hover-fade">
              </picture>
            {% else %}
              {% generateImage params %}
            {% endif %}
          </div>
        </div>

      {% endfor %}
    </div>

    <div class="photo-tooltip" id="photo-tooltip">
      <span class="photo-tooltip__caption"></span>
      <span class="photo-tooltip__hint">click to expand...</span>
    </div>

  </section>
  {% endif %}

  {# =========================================================
     SECTION 5: Drawings
     ========================================================= #}
  {% if drawings and drawings.length %}
  <section class="project-drawings-section">

    <div class="project-section-header">
      <div class="project-section-header-inner">
        <div class="project-section-header-cell">Drawings</div>
      </div>
    </div>

    <div class="project-drawings-grid">
      {% for drawing in drawings %}
        {% set outputFormats = [] %}
        {% for format, i in settings.images %}
          {% if i.enabled === true %}
            {{ '' if outputFormats.push(format) }}
          {% endif %}
        {% endfor %}
        {% set params = {
          "src": drawing.src,
          "alt": drawing.caption or (title + " drawing"),
          "loadingType": "lazy",
          "viewportSizes": "(min-width: 1140px) 22vw, (min-width: 540px) 45vw, 85vw",
          "outputWidths": [
            settings.config.image_grid_width_sm,
            settings.config.image_grid_width_md,
            settings.config.image_grid_width_lg
          ],
          "outputFormats": outputFormats,
          "outputQualityJpeg": settings.images.jpeg.quality,
          "outputQualityWebp": settings.images.webp.quality,
          "outputQualityAvif": settings.images.avif.quality
        } %}
        <div class="project-drawing-cell">
          <div class="drawing-thumb" data-caption="{{ drawing.caption or '' }}" data-fullsrc="{% if not (drawing.src | endsWith('.gif')) %}{% getImageSrc { src: drawing.src, width: settings.config.image_width_md, quality: settings.config.image_quality_mediumsrc } %}{% endif %}" data-ispng="{{ 'true' if drawing.src | endsWith('.png') else '' }}">
            {% if drawing.src | endsWith('.gif') %}
              <picture>
                <img src="/{{ drawing.src }}" alt="{{ drawing.caption or (title + ' drawing') }}" loading="lazy" decoding="async" class="hover-fade">
              </picture>
            {% else %}
              {% generateImage params %}
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>

    <div class="drawing-tooltip" id="drawing-tooltip">
      <span class="drawing-tooltip__caption"></span>
      <span class="drawing-tooltip__hint">click to expand...</span>
    </div>

  </section>
  {% endif %}

  {# =========================================================
     SECTION 6: Design Toolkit (Downloads)
     ========================================================= #}
  {# Hidden Netlify form for download gate analytics — detected at build time #}
  <form name="toolkit-download" data-netlify="true" netlify-honeypot="bot-field" hidden>
    <input type="hidden" name="form-name" value="toolkit-download" />
    <input type="hidden" name="bot-field" />
    <input type="hidden" name="project" />
    <input type="hidden" name="file" />
    <input type="email" name="email" />
  </form>
  {% set toolkitItems = toolkitFiles if toolkitFiles and toolkitFiles.length else downloads %}
  {% if toolkitItems and toolkitItems.length %}
  <section class="project-toolkit-section">
    <div class="grid grid--intro">

      {# Empty left column (spans 1-2) #}
      <div class="grid__item--span-2-left">
      </div>

      {# Design Toolkit in right column (spans 3-4) #}
      <div class="grid__item--span-2-right">

          <div class="project-section-header">
            <div class="project-section-header-inner">
              <div class="project-section-header-cell">Design Toolkit</div>
            </div>
          </div>

          {% for item in toolkitItems %}
            <div class="project-download-row" data-download-url="{{ item.url }}" data-download-title="{{ item.title }}">
              <div class="project-download-cell project-download-cell--title"><svg class="file-icon" width="1em" height="1em" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="currentColor" aria-hidden="true"><path d="M3 23h18V6.709L15.29 1H3zM15 2h.2L20 6.8V7h-5zM4 2h10v6h6v14H4z"/></svg>{{ item.title }}</div>
              <div class="project-download-cell project-download-cell--format">{{ item.format }}</div>
              <div class="project-download-cell project-download-cell--action">
                <button class="arrow arrow--down link-nostyle text--small js-download-trigger" type="button">Download</button>
              </div>
            </div>
            <div class="download-gate" aria-hidden="true">
              <div class="download-gate-inner">
                <input class="download-gate__email" type="email" placeholder="Email address" autocomplete="email" />
                <label class="download-gate__checkbox-row">
                  <input type="checkbox" />
                  <span>I understand that this material is for personal reference only and may not be reproduced or distributed without permission.</span>
                </label>
              </div>
            </div>
          {% endfor %}

      </div>

    </div>
  </section>
  {% endif %}

  {# =========================================================
     SECTION 7: Related Projects
     ========================================================= #}
  <section class="project-related-section pb--6">

    <div class="project-section-header">
      <div class="project-section-header-inner">
        <div class="project-section-header-cell">Related Projects</div>
      </div>
    </div>

    {% set relatedList = collections.projects | relatedProjects(categories, 4, page.url) %}

    {% if relatedList | length %}

      {% set outputFormats = [] %}
      {% for format, i in settings.images %}
        {% if i.enabled === true %}
          {{ '' if outputFormats.push(format) }}
        {% endif %}
      {% endfor %}

      <div class="project-related-grid">
        {% for project in relatedList %}
          <div class="project-related-cell">
            <a href="{{ project.url | url }}" class="link-nostyle">
              <div class="related-thumb">
                {% if project.data.headerImage %}
                  {% set params = {
                    "src": project.data.headerImage.src,
                    "alt": project.data.headerImage.alt or project.data.title,
                    "loadingType": "lazy",
                    "viewportSizes": "(min-width: 1140px) 22vw, (min-width: 840px) 25vw, 45vw",
                    "outputWidths": [
                      settings.config.image_grid_width_sm,
                      settings.config.image_grid_width_md,
                      settings.config.image_grid_width_lg
                    ],
                    "outputFormats": outputFormats,
                    "outputQualityJpeg": settings.images.jpeg.quality,
                    "outputQualityWebp": settings.images.webp.quality,
                    "outputQualityAvif": settings.images.avif.quality
                  } %}
                  {% if project.data.headerImage.src | endsWith('.gif') %}
                    <picture>
                      <img src="/{{ project.data.headerImage.src }}" alt="{{ project.data.headerImage.alt or project.data.title }}" loading="lazy" decoding="async" class="hover-fade">
                    </picture>
                  {% else %}
                    {% generateImage params %}
                  {% endif %}
                {% endif %}
              </div>
              <div class="project-related-title">{{ project.data.title }}</div>
              {% if project.data.description %}
                <div class="project-related-desc">{{ project.data.description }}</div>
              {% endif %}
            </a>
          </div>
        {% endfor %}
      </div>

    {% endif %}

  </section>

  {# =========================================================
     IMAGE EXPAND MODAL (shared by Photos and Drawings)
     ========================================================= #}
  <div class="photo-modal" id="photo-modal" role="dialog" aria-modal="true" hidden>
    <div class="photo-modal__scrim" id="photo-modal-scrim"></div>
    <div class="photo-modal__card">
      <div class="photo-modal__image-wrap">
        <div class="photo-modal__zone-prev" id="photo-modal-zone-prev" aria-hidden="true"></div>
        <div class="photo-modal__placeholder is-hidden" id="photo-modal-placeholder" aria-hidden="true">
          <img id="photo-modal-placeholder-img" src="" alt="" />
        </div>
        <img class="photo-modal__img" id="photo-modal-img" src="" alt="" />
        <div class="photo-modal__zone-next" id="photo-modal-zone-next" aria-hidden="true"></div>
      </div>
      <div class="photo-modal__caption-row">
        <div class="photo-modal__caption" id="photo-modal-caption"></div>
        <div class="photo-modal__counter" id="photo-modal-counter" aria-live="polite"></div>
        <button class="photo-modal__close" id="photo-modal-close" aria-label="Close">×</button>
      </div>
    </div>
  </div>

</article>

<script>
(function() {
  // Photo tooltip
  var photoTooltip = document.getElementById('photo-tooltip');
  if (photoTooltip) {
    var photoCaptionEl = photoTooltip.querySelector('.photo-tooltip__caption');
    var photoThumbs = document.querySelectorAll('.project-photos-grid .photo-thumb');
    photoThumbs.forEach(function(thumb) {
      thumb.addEventListener('mouseenter', function(e) {
        var caption = (thumb.dataset.caption || '').replace(/^\d+\s*/, '');
        photoCaptionEl.textContent = caption;
        photoTooltip.style.display = 'block';
      });
      thumb.addEventListener('mousemove', function(e) {
        photoTooltip.style.left = (e.clientX + 14) + 'px';
        photoTooltip.style.top = (e.clientY + 14) + 'px';
      });
      thumb.addEventListener('mouseleave', function() {
        photoTooltip.style.display = 'none';
      });
    });
  }

  // Drawing tooltip
  var drawingTooltip = document.getElementById('drawing-tooltip');
  if (drawingTooltip) {
    var drawingCaptionEl = drawingTooltip.querySelector('.drawing-tooltip__caption');
    var drawingThumbs = document.querySelectorAll('.project-drawings-grid .drawing-thumb');
    drawingThumbs.forEach(function(thumb) {
      thumb.addEventListener('mouseenter', function(e) {
        var caption = (thumb.dataset.caption || '').replace(/^drawing-?\s*/, '');
        drawingCaptionEl.textContent = caption;
        drawingTooltip.style.display = 'block';
      });
      thumb.addEventListener('mousemove', function(e) {
        drawingTooltip.style.left = (e.clientX + 14) + 'px';
        drawingTooltip.style.top = (e.clientY + 14) + 'px';
      });
      thumb.addEventListener('mouseleave', function() {
        drawingTooltip.style.display = 'none';
      });
    });
  }


  // Download gate
  var SESSION_KEY = 'toolkit-gate-passed';
  var triggers = document.querySelectorAll('.js-download-trigger');
  if (triggers.length) {
    function openGate(gate) {
      gate.classList.add('is-open');
      gate.setAttribute('aria-hidden', 'false');
      var row = gate.previousElementSibling;
      if (row) { row.classList.add('gate-open'); row.classList.remove('gate-ready'); }
      var emailEl = gate.querySelector('.download-gate__email');
      if (emailEl) emailEl.focus();
    }
    function closeGate(gate) {
      gate.classList.remove('is-open');
      gate.setAttribute('aria-hidden', 'true');
      var row = gate.previousElementSibling;
      if (row) { row.classList.remove('gate-open'); row.classList.remove('gate-ready'); }
    }
    function startDownload(url) {
      var a = document.createElement('a');
      a.href = url;
      a.download = '';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
    }
    function markPassed() {
      try { sessionStorage.setItem(SESSION_KEY, '1'); } catch(e) {}
    }
    function hasPassed() {
      try { return sessionStorage.getItem(SESSION_KEY) === '1'; } catch(e) { return false; }
    }
    function unlockAllTriggers() {
      // Replace all remaining trigger buttons with direct download links behavior
      document.querySelectorAll('.js-download-trigger').forEach(function(btn) {
        btn.dataset.gatePassed = '1';
      });
      // Close any open gates
      document.querySelectorAll('.download-gate.is-open').forEach(closeGate);
    }

    // Wire up each gate's form fields
    document.querySelectorAll('.download-gate').forEach(function(gate) {
      var emailEl = gate.querySelector('.download-gate__email');
      var checkEl = gate.querySelector('input[type="checkbox"]');

      // Prevent closing when clicking inside the gate
      gate.addEventListener('click', function(e) {
        e.stopPropagation();
      });

      function validate() {
        var row = gate.previousElementSibling;
        var valid = emailEl.value.trim().length > 0 &&
          /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailEl.value.trim()) &&
          checkEl.checked;
        if (row) {
          row.classList.toggle('gate-ready', valid);
        }
      }

      emailEl.addEventListener('input', validate);
      checkEl.addEventListener('change', validate);
    });

    triggers.forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        var row = btn.closest('.project-download-row');
        var url = row.dataset.downloadUrl;
        // If already passed gate this session, download directly
        if (hasPassed() || btn.dataset.gatePassed) {
          startDownload(url);
          return;
        }
        var gate = row.nextElementSibling;
        if (!gate || !gate.classList.contains('download-gate')) return;
        // If gate is open and ready, submit
        if (gate.classList.contains('is-open') && row.classList.contains('gate-ready')) {
          var emailEl = gate.querySelector('.download-gate__email');
          var fileTitle = row.dataset.downloadTitle || '';
          var projectTitle = document.title || '';

          var formData = new FormData();
          formData.append('form-name', 'toolkit-download');
          formData.append('bot-field', '');
          formData.append('project', projectTitle);
          formData.append('file', fileTitle);
          formData.append('email', emailEl.value.trim());

          fetch('/', { method: 'POST', body: formData })
            .catch(function() {});

          markPassed();
          unlockAllTriggers();
          startDownload(url);
          return;
        }
        // If gate is open but not ready, close it
        if (gate.classList.contains('is-open')) {
          closeGate(gate);
          return;
        }
        // Close any other open gates first, then open this one
        document.querySelectorAll('.download-gate.is-open').forEach(closeGate);
        openGate(gate);
      });
    });

    // Close gates when clicking outside
    document.addEventListener('click', function() {
      document.querySelectorAll('.download-gate.is-open').forEach(closeGate);
    });
  }

  // ---- Image expand: Modal ----
  var modal = document.getElementById('photo-modal');
  if (modal) {
    var allThumbs = [];
    var activeThumbIndex = -1;
    var loadGeneration = 0;
    var modalImg = document.getElementById('photo-modal-img');
    var modalCaption = document.getElementById('photo-modal-caption');
    var modalCounter = document.getElementById('photo-modal-counter');
    var modalClose = document.getElementById('photo-modal-close');
    var modalScrim = document.getElementById('photo-modal-scrim');
    var modalCard = modal.querySelector('.photo-modal__card');
    var zonePrev = document.getElementById('photo-modal-zone-prev');
    var zoneNext = document.getElementById('photo-modal-zone-next');
    var modalPlaceholder = document.getElementById('photo-modal-placeholder');
    var modalPlaceholderImg = document.getElementById('photo-modal-placeholder-img');

    function openModal(imgEl, caption, thumbIndex) {
      var generation = ++loadGeneration;
      var thumb = allThumbs[thumbIndex];
      var fullSrc = (thumb && thumb.dataset.fullsrc) || imgEl.currentSrc || imgEl.src;

      // Show thumbnail as placeholder immediately (already decoded in memory)
      // Set natural dimensions so CSS max-width/max-height scales it up to fill the modal
      var thumbImgEl = thumb ? thumb.querySelector('img') : null;
      if (thumbImgEl && thumbImgEl.currentSrc) {
        modalPlaceholderImg.src = thumbImgEl.currentSrc;
        modalPlaceholderImg.width = thumbImgEl.naturalWidth;
        modalPlaceholderImg.height = thumbImgEl.naturalHeight;
        modalPlaceholder.classList.remove('is-hidden');
      } else {
        modalPlaceholder.classList.add('is-hidden');
      }

      // Load full-res; swap out placeholder the moment it's ready (no fade needed — placeholder provides continuity)
      modalImg.onload = function() {
        if (generation !== loadGeneration) return;
        modalPlaceholder.classList.add('is-hidden');
      };
      modalImg.src = fullSrc;
      var isPng = thumb && thumb.dataset.ispng === 'true';
      modalCard.classList.toggle('has-png-image', isPng);
      modalCaption.textContent = caption || '';
      activeThumbIndex = thumbIndex;
      modalCounter.textContent = (thumbIndex + 1) + ' / ' + allThumbs.length;
      modal.removeAttribute('hidden');
      modal.classList.add('is-open');
      modal.classList.remove('is-closing');
      document.body.style.overflow = 'hidden';
      zonePrev.classList.toggle('is-disabled', activeThumbIndex <= 0);
      zoneNext.classList.toggle('is-disabled', activeThumbIndex >= allThumbs.length - 1);
      modalClose.focus();

      prefetchAdjacent(thumbIndex);
    }

    function navigateModal(direction) {
      var next = activeThumbIndex + direction;
      if (next < 0 || next >= allThumbs.length) return;
      var thumb = allThumbs[next];
      var img = thumb.querySelector('img');
      var caption = (thumb.dataset.caption || '').replace(/^\d+\s*|^drawing-?\s*/i, '');
      openModal(img, caption, next);
    }

    function closeModal() {
      modal.classList.add('is-closing');
      setTimeout(function() {
        modal.classList.remove('is-open', 'is-closing');
        modal.setAttribute('hidden', '');
        document.body.style.overflow = '';
      }, 300);
    }

    // Build allThumbs list in DOM order (photos first, then drawings)
    document.querySelectorAll('.photo-thumb, .drawing-thumb').forEach(function(t) {
      allThumbs.push(t);
    });

    // Prefetch adjacent gallery images so navigation feels instant
    var prefetchCache = {};
    function prefetchImage(src) {
      if (!src || prefetchCache[src]) return;
      prefetchCache[src] = true;
      var img = new Image();
      img.src = src;
    }
    function prefetchAdjacent(index) {
      if (index - 1 >= 0) prefetchImage(allThumbs[index - 1].dataset.fullsrc);
      if (index + 1 < allThumbs.length) prefetchImage(allThumbs[index + 1].dataset.fullsrc);
    }

    // Wire clicks on all thumbs
    allThumbs.forEach(function(thumb, i) {
      thumb.addEventListener('click', function() {
        var img = thumb.querySelector('img');
        var caption = (thumb.dataset.caption || '').replace(/^\d+\s*|^drawing-?\s*/i, '');
        if (img) openModal(img, caption, i);
      });
    });

    // Close button and scrim
    modalClose.addEventListener('click', closeModal);
    modalScrim.addEventListener('click', closeModal);

    // Click zones
    zonePrev.addEventListener('click', function() { navigateModal(-1); });
    zoneNext.addEventListener('click', function() { navigateModal(+1); });

    // Keyboard navigation
    document.addEventListener('keydown', function(e) {
      if (!modal.classList.contains('is-open')) return;
      if (e.key === 'Escape') closeModal();
      if (e.key === 'ArrowLeft') navigateModal(-1);
      if (e.key === 'ArrowRight') navigateModal(+1);
    });

    // Touch swipe
    var touchStartX = 0;
    modalCard.addEventListener('touchstart', function(e) {
      touchStartX = e.changedTouches[0].clientX;
    }, { passive: true });
    modalCard.addEventListener('touchend', function(e) {
      var dx = e.changedTouches[0].clientX - touchStartX;
      if (Math.abs(dx) > 40) navigateModal(dx < 0 ? 1 : -1);
    }, { passive: true });
  }
  // Portrait header: set --portrait-image-bleed so Trade/Awards tables start
  // just below the image bottom edge
  var portraitSection = document.querySelector('section.is-portrait-header');
  if (portraitSection) {
    var portraitImgContainer = document.querySelector('.project-header.is-portrait-header .grid__item--span-2-left');
    function setPortraitBleed() {
      if (!portraitImgContainer) return;
      var imgBottom = portraitImgContainer.getBoundingClientRect().bottom;
      var sectionTop = portraitSection.getBoundingClientRect().top;
      var bleed = Math.max(0, imgBottom - sectionTop);
      portraitSection.style.setProperty('--portrait-image-bleed', bleed + 'px');
    }
    setPortraitBleed();
    window.addEventListener('resize', setPortraitBleed);
  }

})();
</script>

