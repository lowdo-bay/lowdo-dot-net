---
layout: layouts/base.njk
section: home
permalink: "/index.html"
---
<style>
  /* Reuse project-header styles for homepage header */
  .project-header {
    border-top: var(--grid-line-thickness) var(--grid-line-horizontal-major-style) var(--grid-line-color);
    padding: 0 !important;
    height: 30vh;
  }

  .project-header .grid {
    align-items: start;
    height: 100%;
  }

  .project-header .grid__item--span-2-left {
    align-self: stretch;
    padding: 0;
    margin: 0;
    height: 100%;
    overflow: hidden;
  }

  .project-header picture.header-image {
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden;
  }

  .project-header picture.header-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .project-header .grid__item--span-2-right {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-self: start;
  }

  .header-description {
    grid-column: 1;
    padding: var(--space-2);
    font-size: var(--font-size-base);
  }

  .header-logo {
    grid-column: 2;
    padding: var(--space-2);
    display: flex;
    justify-content: flex-start;
    align-items: flex-start;
  }

  /* Mobile: stack header image on top, description and logo side by side below */
  @media (max-width: 839px) {
    .project-header {
      margin-left: 0;
      margin-right: 0;
    }

    .project-header .grid {
      grid-template-columns: 1fr;
    }

    .project-header .grid__item--span-2-left {
      padding: 0;
      margin: 0;
      overflow: hidden;
    }

    .project-header .grid__item--span-2-left,
    .project-header .grid__item--span-2-right {
      grid-column: 1;
    }

    .project-header .grid__item--span-2-right {
      grid-template-columns: 4fr 1fr;
      padding-left: var(--space-2);
      padding-right: var(--space-2);
    }
  }

  .header-logo img {
    width: 30%;
    height: auto;
    max-width: 100%;
  }

  html[dark] .header-logo img {
    content: url('/assets/uploads/innovation star white.png');
  }

  /* Expertise section styles */
  .expertise-section {
    position: relative;
    padding-top: 0 !important;
    margin-top: calc(var(--space-8) - var(--space)) !important;
  }

  .expertise-section::before {
    content: '';
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    height: var(--grid-line-thickness);
    border-top: var(--grid-line-thickness) var(--grid-line-horizontal-major-style) var(--grid-line-color);
    top: 0;
  }

  .expertise-section::after {
    content: '' !important;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    height: var(--grid-line-thickness);
    border-top: var(--grid-line-thickness) var(--grid-line-horizontal-major-style) var(--grid-line-color);
    bottom: 0;
    padding: 0 !important;
    margin: 0 !important;
    border-bottom: none !important;
  }

  .expertise-section .grid {
    row-gap: 0;
    column-gap: 0;
    grid-template-rows: auto auto auto;
    padding-top: 0;
  }

  /* Grid row placement utilities */
  .expertise-section .row-1 { grid-row: 1; }
  .expertise-section .row-2 { grid-row: 2; }
  .expertise-section .row-3 { grid-row: 3; }


  /* Padding for all non-image rows */
  .expertise-section .row-2,
  .expertise-section .row-3 {
    position: relative;
  }

  .expertise-heading {
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent-1);
    font-size: var(--font-size-base);
    align-self: start;
    padding: var(--space-2);
  }

  .expertise-image {
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    padding: var(--space-2);
  }

  .expertise-image picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .expertise-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .expertise-lead {
    color: var(--color-accent-1);
    font-weight: 500;
    line-height: calc(1.6 * var(--line-height-scale) / 100);
    padding: var(--space-2);
  }

  .expertise-body {
    font-size: var(--font-size-base);
    line-height: calc(1.6 * var(--line-height-scale) / 100);
    padding: var(--space-2);
  }

  .expertise-body p {
    margin: 0;
  }

  /* Mobile responsive: reset grid-row to auto for single-column layout */
  @media (max-width: 839px) {
    .expertise-section .row-1,
    .expertise-section .row-2,
    .expertise-section .row-3 {
      grid-row: auto;
    }
  }

  /* Tech Portfolio section styles */
  .tech-portfolio-section {
    position: relative;
    margin-top: var(--space-8);
    padding-top: 0 !important;
  }

  .tech-portfolio-section::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    background-color: var(--color-accent-5);
    border-top: var(--grid-line-thickness) var(--grid-line-horizontal-major-style) var(--grid-line-color);
    z-index: -1;
  }

  .tech-portfolio-section::after {
    content: '';
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    border-bottom: var(--grid-line-thickness) solid var(--grid-line-color) !important;
    bottom: 0;
    z-index: 9999;
  }

  .tech-portfolio-section .grid {
    row-gap: 0;
    column-gap: 0;
    align-items: center;
  }

  .tech-portfolio-description {
    color: var(--color-accent-1);
    padding: var(--space-2);
    font-size: var(--font-size-base);
    align-self: start;
  }

  .tech-portfolio-diagram {
    grid-column: span 3;
    padding: var(--space-2);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 300px;
    border: 1px dashed rgba(0, 20, 137, 0.2);
    color: var(--color-accent-1);
    font-size: var(--font-size-base);
  }

  /* Awards & Recognition section */
  .awards-section {
    position: relative;
    margin-top: var(--space-8);
    padding-top: 0 !important;
  }

  .awards-section::before {
    content: '';
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    border-top: var(--grid-line-thickness) var(--grid-line-horizontal-major-style) var(--grid-line-color);
    top: 0;
  }

  .awards-section::after {
    content: '';
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    border-bottom: var(--grid-line-thickness) solid var(--grid-line-color) !important;
    bottom: 0;
  }


  .awards-section .grid {
    row-gap: 0;
    column-gap: 0;
    align-items: start;
  }

  .awards-heading {
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent-1);
    font-size: var(--font-size-base);
    padding: var(--space-2);
  }

  .awards-blurb {
    font-size: var(--font-size-base);
    padding: var(--space-2);
    padding-top: 0;
  }

  .awards-see-more {
    display: block;
    padding: var(--space-2);
    padding-top: 0;
    font-size: var(--font-size-base);
    color: var(--color-accent-1);
    text-decoration: none;
  }

  .awards-see-more:hover {
    text-decoration: underline;
  }

  .awards-layout {
    display: flex;
    align-items: flex-start;
  }

  .awards-layout > :first-child {
    flex: 0 0 25%;
  }

  .awards-table {
    flex: 1;
  }

  .awards-table-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: var(--grid-line-thickness) var(--grid-line-horizontal-minor-style) var(--grid-line-color);
  }

  @media (max-width: 839px) {
    .awards-layout {
      flex-direction: column;
    }

    .awards-layout > :first-child {
      flex: none;
      width: 100%;
    }
  }

  .awards-col-header {
    font-weight: bold;
    text-transform: uppercase;
    font-size: var(--font-size-base);
    padding: var(--space-2);
  }

  .awards-col-cell {
    font-size: var(--font-size-base);
    padding: var(--space-2);
  }

  /* Featured Projects section */
  .featured-projects-section {
    margin-top: var(--space-6);
  }

  .featured-projects-section .project-section-header {
    position: relative;
    padding-bottom: 0;
  }

  .featured-projects-section .project-section-header::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    border-bottom: var(--grid-line-thickness) var(--grid-line-horizontal-major-style) var(--grid-line-color);
  }

  .featured-projects-section .project-section-header-inner {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (min-width: 840px) {
    .featured-projects-section .project-section-header-inner {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .featured-projects-section .project-section-header-cell {
    padding: var(--space-2);
    font-size: var(--font-size-small);
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .featured-projects-section .project-related-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  @media (min-width: 840px) {
    .featured-projects-section .project-related-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .featured-projects-section .project-related-cell {
    padding: var(--space-2);
    position: relative;
  }

  .featured-projects-section .project-related-cell:nth-child(2n)::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 200vw;
    border-bottom: var(--grid-line-thickness) var(--grid-line-horizontal-minor-style) var(--grid-line-color);
  }

  @media (min-width: 840px) {
    .featured-projects-section .project-related-cell:nth-child(2n)::after { display: none; }
    .featured-projects-section .project-related-cell:nth-child(4n)::after { display: block; }
  }

  .featured-projects-section .related-thumb {
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    margin-bottom: var(--space-2);
  }

  .featured-projects-section .related-thumb picture,
  .featured-projects-section .related-thumb img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  .featured-projects-section .project-related-title {
    font-size: var(--font-size-small);
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-1);
  }

  .featured-projects-section .project-related-desc {
    font-size: var(--font-size-small);
    opacity: 0.7;
  }

  /* Contact Section */
  .contact-section {
    position: relative;
    margin-top: calc(var(--space-8) - var(--space)) !important;
  }

  .contact-section::before {
    content: '';
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    border-top: var(--grid-line-thickness) var(--grid-line-horizontal-major-style) var(--grid-line-color);
    top: 0;
  }

  .contact-section::after {
    content: '' !important;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    border-top: var(--grid-line-thickness) var(--grid-line-horizontal-major-style) var(--grid-line-color);
    bottom: 0;
  }

  .contact-image-col {
    grid-row: 1 / span 999;
  }

  .contact-image-col img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  .contact-heading {
    grid-row: 1 / span 999;
    padding: var(--space-2);
    font-weight: bold;
    color: var(--color-accent-1);
    text-transform: uppercase;
    align-self: start;
  }

  .contact-row {
    padding: var(--space-2);
    border-top: var(--grid-line-thickness) var(--grid-line-horizontal-minor-style) var(--grid-line-color);
    text-transform: uppercase;
  }

  .contact-row:first-of-type {
    border-top: none;
  }

  .contact-row.col-3 {
    color: var(--color-accent-3);
  }

  .contact-row.col-4 {
    color: var(--color-accent-1);
  }

  .contact-row a {
    color: inherit;
  }
</style>

<article>

  <header class="project-header">
    <div class="grid grid--intro">

      {# Left: Header Image #}
      <div class="grid__item--span-2-left">
        {% set outputFormats = [] %}
        {% for format, i in settings.images %}
          {% if i.enabled === true %}
            {{ '' if outputFormats.push(format) }}
          {% endif %}
        {% endfor %}
        {% set params = {
          "src": "/assets/images/homepage-header.jpg",
          "alt": "Low Design Office",
          "classes": "header-image",
          "loadingType": "eager",
          "viewportSizes": "50vw",
          "outputWidths": [
            settings.config.image_width_sm,
            settings.config.image_width_md,
            settings.config.image_width_lg
          ],
          "outputFormats": outputFormats,
          "outputQualityJpeg": settings.images.jpeg.quality,
          "outputQualityWebp": settings.images.webp.quality,
          "outputQualityAvif": settings.images.avif.quality
        } %}
        {% generateImage params %}
      </div>

      {# Right: Description and Logo — 2-col sub-grid #}
      <div class="grid__item--span-2-right">

        {# Description #}
        <div class="header-description markdown">
          {{ settings.metadata.site_description | renderUsingMarkdown | safe }}
        </div>

        {# Logo #}
        <div class="header-logo">
          <img src="/assets/uploads/favicon.png" alt="LowDO logo">
        </div>

      </div>

    </div>
  </header>

  {# Expertise Section #}
  <section class="expertise-section">
    <div class="grid grid--description">

      {# Row 1: Heading (Col 1) + Images (Cols 2-4) #}
      <div class="expertise-heading col-1 row-1">
        WE ARE ARCHITECTS, BUILDERS, AND SYSTEMS-THINKERS
      </div>

      {# Architects Image (Row 1) #}
      <div class="expertise-image col-2 row-1">
        {% set outputFormats = [] %}
        {% for format, i in settings.images %}
          {% if i.enabled === true %}
            {{ '' if outputFormats.push(format) }}
          {% endif %}
        {% endfor %}
        {% set params = {
          "src": "/assets/images/expertise-architects.jpg",
          "alt": "Architects",
          "loadingType": "lazy",
          "viewportSizes": "25vw",
          "outputWidths": [
            settings.config.image_grid_width_sm,
            settings.config.image_grid_width_md,
            settings.config.image_grid_width_lg
          ],
          "outputFormats": outputFormats,
          "outputQualityJpeg": settings.images.jpeg.quality,
          "outputQualityWebp": settings.images.webp.quality,
          "outputQualityAvif": settings.images.avif.quality
        } %}
        {% generateImage params %}
      </div>

      {# Row 2 Divider #}
      <div style="grid-column: 1 / -1; grid-row: 2; position: relative; height: 0; border-top: var(--grid-line-thickness) var(--grid-line-horizontal-minor-style) var(--grid-line-color);"></div>

      {# Architects Lead Text (Row 2) #}
      <div class="expertise-lead markdown col-2 row-2">
        As **ARCHITECTS**, we make architecture for the now, rooted in culture and context, driven by societal and planetary well-being.
      </div>

      {# Row 3 Divider #}
      <div style="grid-column: 1 / -1; grid-row: 3; position: relative; height: 0; border-top: var(--grid-line-thickness) var(--grid-line-horizontal-minor-style) var(--grid-line-color);"></div>

      {# Architects Body Text (Row 3) #}
      <div class="expertise-body markdown col-2 row-3">
        At Low Design Office, we leverage low-cost materials, low-energy technologies, and low-carbon strategies to deliver inspiring and impactful environments.

        By rethinking design and delivery methods, we lower barriers to access while raising the standard for efficiency in building construction. Our "more with less" approach transforms scarcity into innovation, making custom architecture more sustainable, equitable, and efficient than traditional approaches.
      </div>

      {# Builders Image (Row 1) #}
      <div class="expertise-image col-3 row-1">
        {% set outputFormats = [] %}
        {% for format, i in settings.images %}
          {% if i.enabled === true %}
            {{ '' if outputFormats.push(format) }}
          {% endif %}
        {% endfor %}
        {% set params = {
          "src": "/assets/images/expertise-builders.jpg",
          "alt": "Builders",
          "loadingType": "lazy",
          "viewportSizes": "25vw",
          "outputWidths": [
            settings.config.image_grid_width_sm,
            settings.config.image_grid_width_md,
            settings.config.image_grid_width_lg
          ],
          "outputFormats": outputFormats,
          "outputQualityJpeg": settings.images.jpeg.quality,
          "outputQualityWebp": settings.images.webp.quality,
          "outputQualityAvif": settings.images.avif.quality
        } %}
        {% generateImage params %}
      </div>

      {# Builders Lead Text (Row 2) #}
      <div class="expertise-lead markdown col-3 row-2">
        As **BUILDERS**, we bridge design and construction—often fabricating and building our own projects—to ensure transparency, affordability, and healthful outcomes.
      </div>

      {# Builders Body Text (Row 3) #}
      <div class="expertise-body markdown col-3 row-3">
        Whether in the studio or on the jobsite, we treat all participants as collaborators, fostering open dialogue that transforms site-specific challenges into adaptable, efficient, and sustainable solutions that minimize stress on people and ecosystems alike. This hands-on, integrated process not only deepens our knowledge but also sets a foundation for innovation and trust in every project.
      </div>

      {# Systems-Thinkers Image (Row 1) #}
      <div class="expertise-image col-4 row-1">
        {% set outputFormats = [] %}
        {% for format, i in settings.images %}
          {% if i.enabled === true %}
            {{ '' if outputFormats.push(format) }}
          {% endif %}
        {% endfor %}
        {% set params = {
          "src": "/assets/images/expertise-systems-thinkers.jpg",
          "alt": "Systems-Thinkers",
          "loadingType": "lazy",
          "viewportSizes": "25vw",
          "outputWidths": [
            settings.config.image_grid_width_sm,
            settings.config.image_grid_width_md,
            settings.config.image_grid_width_lg
          ],
          "outputFormats": outputFormats,
          "outputQualityJpeg": settings.images.jpeg.quality,
          "outputQualityWebp": settings.images.webp.quality,
          "outputQualityAvif": settings.images.avif.quality
        } %}
        {% generateImage params %}
      </div>

      {# Systems-Thinkers Lead Text (Row 2) #}
      <div class="expertise-lead markdown col-4 row-2">
        As **SYSTEMS-THINKERS**, we develop systems that can evolve, be retooled, and reinvented to meet individual and collective challenges.
      </div>

      {# Systems-Thinkers Body Text (Row 3) #}
      <div class="expertise-body markdown col-4 row-3">
        We are community-focused and systems-based, leading design for planetary and social equity. By leveraging the power of thinking small, we transform resource constraints into opportunities for innovation—using low-tech, low-carbon methods, and open-source designs to realize more with less. Through participatory processes, we strive for efficiency, affordability, and equity, incrementally improving places for people and planet.
      </div>

    </div>
  </section>

  {# Tech Portfolio Section #}
  <section class="tech-portfolio-section">
    <div class="grid grid--description">

      {# Col 1: Description text #}
      <div class="tech-portfolio-description markdown col-1">
        LowDO's work spans a diverse network of projects, collaborators, and systems—from housing and civic infrastructure to fabrication and open-source tools. Our portfolio reflects deep connections across disciplines: architecture, construction, community organizing, and environmental stewardship. Each project is a node in an evolving network of ideas, partners, and places.
      </div>

      {# Cols 2–4: Diagram placeholder #}
      <div class="tech-portfolio-diagram col-2" style="grid-column: 2 / -1;">
        [ Diagram — drop PNG or SVG here ]
      </div>

    </div>
  </section>

  {# Awards & Recognition Section #}
  <section class="awards-section">

    <div class="awards-layout">

    {# Col 1: Description #}
    <div style="padding: var(--space-2);">
      <div class="awards-heading">AWARDS &amp; RECOGNITION</div>
      <div class="awards-blurb">With our commitment to building societal equity through design, LowDO has been internationally recognized as an emerging leader in our profession.</div>
      <a href="/all/?type=award" class="awards-see-more">see more...</a>
    </div>

    {# Table: column headers + data rows #}
    <div class="awards-table">

      {# Column headers #}
      <div class="awards-table-row">
        <div class="awards-col-header">AWARD</div>
        <div class="awards-col-header">ORGANIZATION</div>
        <div class="awards-col-header">YEAR</div>
      </div>

      {# Data rows #}
      {% for entry in collections.entries %}
        {% if entry.data.entryType === "award" and entry.data.featured === true and entry.data.draft !== true %}
          <div class="awards-table-row">
            <div class="awards-col-cell">{{ entry.data.title }}</div>
            <div class="awards-col-cell">{{ entry.data.subtitle }}</div>
            <div class="awards-col-cell">{{ entry.data.date | dateFullYear }}</div>
          </div>
        {% endif %}
      {% endfor %}

    </div>

    </div>{# end awards-layout #}

  </section>

  {# Featured Projects Section #}
  {% set featuredProjects = [] %}
  {% for project in collections.projects %}
    {% if project.data.featured === true %}
      {{ '' if featuredProjects.push(project) }}
    {% endif %}
  {% endfor %}

  {% if featuredProjects | length %}
    <section class="featured-projects-section pb--6">

      <div class="project-section-header">
        <div class="project-section-header-inner">
          <div class="project-section-header-cell">Featured Projects</div>
        </div>
      </div>

      {% set outputFormats = [] %}
      {% for format, i in settings.images %}
        {% if i.enabled === true %}
          {{ '' if outputFormats.push(format) }}
        {% endif %}
      {% endfor %}

      <div class="project-related-grid">
        {% for project in featuredProjects %}
          <div class="project-related-cell">
            <a href="{{ project.url | url }}" class="link-nostyle">
              <div class="related-thumb">
                {% if project.data.headerImage %}
                  {% set params = {
                    "src": project.data.headerImage.src,
                    "alt": project.data.headerImage.alt or project.data.title,
                    "loadingType": "lazy",
                    "viewportSizes": "(min-width: 1140px) 22vw, (min-width: 840px) 25vw, 45vw",
                    "outputWidths": [
                      settings.config.image_grid_width_sm,
                      settings.config.image_grid_width_md,
                      settings.config.image_grid_width_lg
                    ],
                    "outputFormats": outputFormats,
                    "outputQualityJpeg": settings.images.jpeg.quality,
                    "outputQualityWebp": settings.images.webp.quality,
                    "outputQualityAvif": settings.images.avif.quality
                  } %}
                  {% generateImage params %}
                {% endif %}
              </div>
              <div class="project-related-title">{{ project.data.title }}</div>
              {% if project.data.description %}
                <div class="project-related-desc">{{ project.data.description }}</div>
              {% endif %}
            </a>
          </div>
        {% endfor %}
      </div>

    </section>
  {% endif %}

