---
permalink: /_redirects
eleventyExcludeFromCollections: true
---
# Generated by redirects.njk on every build. Do not edit the output by hand.
# Project URLs drop the YYMMDD_ job-code prefix that the folder names keep, so each
# old dated address is permanently redirected to its clean one.
{% for entry in collections.all -%}
{%- set oldUrl = "/project/" + entry.fileSlug + "/" -%}
{%- if entry.url and entry.url.indexOf("/project/") == 0 and entry.url != oldUrl -%}
/project/{{ entry.fileSlug }}  {{ entry.url }}  301
{% endif -%}
{%- endfor %}
